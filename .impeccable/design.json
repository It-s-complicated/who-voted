      "css": ".ds-breadcrumbs{display:flex;flex-wrap:wrap;gap:.35rem .7rem;color:var(--text-muted);font:.88rem var(--font-body)}.ds-breadcrumbs a{color:inherit;text-decoration-color:var(--primary);text-underline-offset:.18em}.ds-breadcrumbs a:hover{color:var(--primary)}.ds-breadcrumbs a:focus-visible{outline:2px solid var(--primary);outline-offset:2px}.ds-breadcrumbs span:not([aria-current]){color:var(--callout-line)}"
    },
    {
      "name": "Sankey figure caption",
      "kind": "custom",
      "refersTo": "figure-caption",
      "description": "Warm methodology panel beneath the white chart area.",
      "html": "<figure class=\"ds-figure\"><div class=\"ds-chart\">Wahlbeteiligung · Diagramm</div><figcaption>Bevölkerungsdaten: Stand und Schätzungen sind zur Grafik erläutert.</figcaption></figure>",
      "css": ".ds-figure{margin:0;overflow:hidden;background:var(--surface);border:1px solid var(--ink);color:var(--ink);font-family:var(--font-body)}.ds-chart{min-height:8rem;padding:1.1rem}.ds-figure figcaption{padding:.9rem 1.1rem 1rem;color:var(--text-muted);background:var(--caption-surface);border-top:1px solid var(--ink);font-size:.8rem;line-height:1.55}"
    },
    {
      "name": "Chart export menu",
      "kind": "custom",
      "refersTo": "chart-menu",
      "description": "SVG and PNG downloads in the chart context menu.",
      "html": "<div class=\"ds-chart-menu\" role=\"menu\"><button role=\"menuitem\">SVG herunterladen</button><button role=\"menuitem\">PNG herunterladen</button></div>",
      "css": ".ds-chart-menu{width:max-content;min-width:12rem;padding:.35rem;color:var(--ink);background:var(--surface);border:1px solid var(--divider);box-shadow:0 6px 18px #1c1b1a26;font:.85rem var(--font-body)}.ds-chart-menu button{display:block;width:100%;padding:.55rem .65rem;color:inherit;background:transparent;border:0;text-align:left;font:inherit;cursor:pointer}.ds-chart-menu button:hover,.ds-chart-menu button:focus-visible{background:var(--caption-surface)}.ds-chart-menu button:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Data disclosure",
      "kind": "custom",
      "refersTo": "data-disclosure",
      "description": "Native expandable data table with tabular figures.",
      "html": "<details class=\"ds-data\"><summary>Daten als Tabelle</summary><div><table><thead><tr><th>Gruppe</th><th>Anzahl</th></tr></thead><tbody><tr><th scope=\"row\">Einwohner:innen</th><td>3.850.809</td></tr><tr><th scope=\"row\">Wahlberechtigt</th><td>2.431.776</td></tr></tbody></table></div></details>",
      "css": ".ds-data{background:var(--surface);border:1px solid var(--ink);color:var(--ink);font-family:var(--font-body)}.ds-data summary{padding:.85rem 1.1rem;cursor:pointer;font-weight:650}.ds-data summary::marker{color:var(--primary)}.ds-data>div{overflow-x:auto;padding:0 1.1rem 1.1rem}.ds-data table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.ds-data th,.ds-data td{padding:.55rem .65rem;border-bottom:1px solid var(--table-divider);text-align:right}.ds-data th:first-child{text-align:left}.ds-data thead th{color:var(--text-muted);font-size:.72rem;font-weight:650;text-transform:uppercase;letter-spacing:.07em;border-bottom:1px solid var(--ink)}.ds-data :focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Source links",
      "kind": "custom",
      "refersTo": "source-link",
      "description": "Muted footer with official source links and editorial top rule.",
      "html": "<footer class=\"ds-sources\"><p>Quellen: <a href=\"#\">Amtliche Wahldaten</a> und <a href=\"#\">Bevölkerungsdaten</a>.</p></footer>",
      "css": ".ds-sources{display:grid;gap:.35rem;margin-top:1.5rem;padding-top:.9rem;color:var(--text-muted);font:.82rem/1.5 var(--font-body);border-top:3px solid var(--ink)}.ds-sources p{margin:0}.ds-sources a{color:inherit;text-decoration-color:var(--primary);text-decoration-thickness:1px;text-underline-offset:.18em}.ds-sources a:hover{color:var(--primary)}.ds-sources a:focus-visible{outline:2px solid var(--primary);outline-offset:2px}"
    },
    {
      "name": "Social preview card",
      "kind": "custom",
      "description": "Fixed-format sharing image with a Fraunces title over faint chart bands.",
      "html": "<div class=\"ds-preview\"><div class=\"ds-preview-bands\"><i></i><i></i><i></i></div><div class=\"ds-preview-copy\"><p>Wer hat gewählt?</p><h1>Berlin</h1></div></div>",
      "css": ".ds-preview{position:relative;display:flex;align-items:center;width:480px;height:252px;overflow:hidden;background:var(--paper);color:var(--ink);font-family:var(--font-display),Georgia,serif}.ds-preview-bands{position:absolute;inset:29px 26px;display:flex;justify-content:space-around;opacity:.35}.ds-preview-bands i{width:19px;height:100%;background:#2a3861}.ds-preview-bands i:nth-child(2){background:#5b84bb}.ds-preview-bands i:nth-child(3){background:#7c9dc9}.ds-preview-copy{position:relative;margin-left:29px;text-shadow:0 2px 12px rgba(28,27,26,.15)}.ds-preview-copy p{margin:0;color:var(--primary);font-size:12px;font-weight:620}.ds-preview-copy h1{margin:7px 0 0;font-size:38px;font-weight:620;line-height:1.02}"
    }
  ],
  "narrative": {
    "northStar": "The Election Ledger",
    "overview": "An editorial, factual, restrained system: expressive serif headlines sit above precise sans-serif data on warm paper. Strong rules frame the content; the visualization supplies the broad areas of color. Pages and controls are flat, square, and restrained.\n\nThis records the current shared system in `src/styles/global.css`, the index and election pages, `src/components/ElectionChart.astro`, and the social preview card. Global interface colors are CSS custom properties; chart category colors remain literal values in the election page. The metaphor and color names describe the observed design. Political neutrality remains a binding commitment from `PRODUCT.md`.",
    "keyCharacteristics": [
      "Fraunces headlines paired with system sans-serif reading and data text.",
      "Warm paper, white panels, and dark editorial rules.",
      "Small red interface accents; semantic color in the chart.",
      "Native controls, rule-led index pages, and horizontally scrollable data presentation."
    ],
    "rules": [
      {
        "name": "The Data Color Rule",
        "body": "Preserve category-to-color mappings and keep interface red distinct from the SPD data red.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** reserve Fraunces for display headlines and use sans-serif for reading, controls, and data.",
      "**Do** preserve semantic chart colors, explicit labels, and the accompanying data table.",
      "**Do** retain square borders, warm neutral surfaces, and visible keyboard focus.",
      "**Do** keep wide diagrams and tables inside their own scroll containers.",
      "**Do** keep the index, breadcrumb, and election pages within the same editorial column and link treatment."
    ],
    "donts": [
      "**Don't** use party colors as interface action or status colors.",
      "**Don't** replace native disclosure and select behavior with decorative imitations.",
      "**Don't** treat synthesized preview color ramps as implemented palette tokens.",
      "**Don't** apply the chart export popover's shadow to ordinary panels."
    ]
  }
}
