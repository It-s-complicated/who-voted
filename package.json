{
  "name": "who-voted",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "data:download": "node scripts/download-data.mjs",
    "data:build": "node scripts/process-data.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node scripts/check-raw-snapshots.mjs && pnpm data:build && node scripts/check-data.mjs && pnpm check && astro build && node scripts/check-states.mjs && node scripts/check-diagram.mjs"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "astro-cards": "^1.0.1",
    "d3-sankey": "^0.12.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
