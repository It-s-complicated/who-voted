---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import "../../styles/global.css";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { renderCard } from "astro-cards/runtime";
import { states } from "../../data/states";
import type { ElectionData } from "../../data/election";
import { readFileSync } from "node:fs";
import { sankey, sankeyLeft, sankeyLinkHorizontal } from "d3-sankey";
import type { SankeyLink, SankeyNode } from "d3-sankey";

export function getStaticPaths() {
  return Object.entries(states).flatMap(([state, { years }]) =>
    years.map((year) => ({ params: { state, year: String(year) } })),
  );
}

const state = states[Astro.params.state ?? ""];
if (!state) throw new Error(`Unknown state: ${Astro.params.state}`);

type DiagramNode = {
  id: string;
  label: string;
  value: number;
  voteUnit?: boolean;
  sourceValue?: number;
  color: string;
  order: number;
  callout?: boolean;
};
type DiagramLink = { source: string; target: string; value: number };
type LayoutNode = SankeyNode<DiagramNode, DiagramLink> &
  Required<
    Pick<SankeyNode<DiagramNode, DiagramLink>, "x0" | "x1" | "y0" | "y1">
  >;
type LayoutLink = SankeyLink<DiagramNode, DiagramLink> & {
  source: LayoutNode;
  target: LayoutNode;
  width: number;
};

const data = JSON.parse(
  readFileSync(
    `public/data/${Astro.params.state}/${Astro.params.year}.json`,
    "utf8",
  ),
) as ElectionData;
const format = new Intl.NumberFormat("de-DE");
function percentage(value: number): string {
  return `${((value / data.population.residents) * 100).toFixed(1).replace(".", ",")} %`;
}
function nodeValue(
  node: DiagramNode,
  value = node.value,
): string {
  if (node.sourceValue !== undefined) return `ca. ${format.format(Math.round(value / 1000) * 1000)} · ~${Math.round(value / data.population.residents * 100)} %`;
  return node.voteUnit && data.secondVotes.votesPerVoter > 1
    ? percentage(value)
    : `${format.format(value)} · ${percentage(value)}`;
}
// ponytail: 5% identifies new seat winners in current datasets; add seat metadata
// if a future newcomer enters parliament below the threshold.
const threshold = 0.05;
const previousParliament = new Set(
  state.elections[data.year].previousParliament.map((party: string) => party.toLocaleLowerCase("de-DE")),
);
const partyColors: Record<string, string> = {
  cdu: "#202831",
  csu: "#202831",
  bsw: "#792351",
  "freie wähler": "#d88023",
  ssw: "#246895",
  spd: "#e54040",
  grüne: "#30a84b",
  "die linke": "#bd4598",
  afd: "#2996cc",
  fdp: "#f3d330",
  biw: "#005ab0",
};
const displayedParties = data.secondVotes.parties.filter(
  (party) =>
    previousParliament.has(party.name.toLocaleLowerCase("de-DE")) ||
    party.votes / data.secondVotes.valid >= threshold,
);
if (
  displayedParties.some(
    (party, index) =>
      index > 0 && party.votes > displayedParties[index - 1].votes,
  )
) {
  throw new Error("Displayed parties must be sorted by votes");
}
const otherVotes =
  data.secondVotes.valid -
  displayedParties.reduce((sum, party) => sum + party.votes, 0);
const partyValues = [...displayedParties.map((party) => party.votes), otherVotes];
const narrowPartyBands = partyValues
  .filter((votes) => votes / data.secondVotes.valid < 0.1).length;
const ballots = data.ballots;
const votesPerVoter = data.secondVotes.votesPerVoter;
const multiVote = votesPerVoter > 1;
const breakdown = data.eligibility.estimatedBreakdown;
const demographicTotal = breakdown
  ? breakdown.underVotingAge + breakdown.nonGermanVotingAgeOrOlder
  : 0;
const estimatedUnderAge = demographicTotal > 0 && breakdown
  ? data.eligibility.notEligible * breakdown.underVotingAge / demographicTotal
  : 0;
const estimatedNonGerman = demographicTotal > 0
  ? data.eligibility.notEligible - estimatedUnderAge
  : 0;
const demographicDifference = data.eligibility.notEligible - demographicTotal;
const noValidLabel = data.secondVotes.noValidLabel ?? "Keine gültige Zweitstimme";
const unusedVotes = ballots
  ? ballots.valid * votesPerVoter - data.secondVotes.valid
  : 0;
const resultStatusLabels: Record<string, string> = {
  final: "Endgültiges Ergebnis",
  preliminary: "Vorläufiges Ergebnis",
};
const populationDate = new Intl.DateTimeFormat("de-DE", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(data.population.referenceDate));
const topParties = displayedParties
  .slice(0, 5)
  .map((party) => party.name)
  .join(", ");

// OG card: simplified sankey on the residents scale (votes normalize by votesPerVoter).
const ogFlow = [
  [{ color: "#2a3861", share: 1 }],
  [
    { color: "#5b84bb", share: data.eligibility.eligible / data.population.residents },
    { color: "#918e8e", share: data.eligibility.notEligible / data.population.residents },
  ],
  [
    { color: "#7c9dc9", share: data.turnout.voters / data.population.residents },
    { color: "#b5b4b4", share: data.turnout.nonVoters / data.population.residents },
  ],
  [
    ...displayedParties.map((party) => ({
      color: partyColors[party.name.toLowerCase()] ?? "#76716b",
      share: party.votes / (data.population.residents * votesPerVoter),
    })),
    { color: "#b2b2b2", share: otherVotes / (data.population.residents * votesPerVoter) },
  ],
];
const ogCard = await renderCard("og", {
  heading: state.name,
  sub: String(Astro.params.year),
  flow: ogFlow,
});

const nodes: DiagramNode[] = [
  {
    id: "residents",
    label: "Einwohner:innen",
    value: data.population.residents,
    color: "#2a3861",
    order: 0,
  },
  {
    id: "eligible",
    label: "Wahlberechtigt",
    value: data.eligibility.eligible,
    color: "#5b84bb",
    order: 0,
  },
  {
    id: "notEligible",
    label: "Nicht wahlberechtigt",
    value: data.eligibility.notEligible,
    color: "#918e8e",
    order: 1,
  },
  {
    id: "voters",
    label: "Wähler:innen",
    value: data.turnout.voters,
    color: "#7c9dc9",
    order: 0,
  },
  {
    id: "nonVoters",
    label: "Nicht gewählt",
    value: data.turnout.nonVoters,
    color: "#b5b4b4",
    order: 1,
  },
  ...(breakdown && demographicTotal > 0 ? [
  {
    id: "underAge",
    label: `Unter ${data.votingAge}*`,
    value: estimatedUnderAge,
    sourceValue: breakdown.underVotingAge,
    color: "#aaa8a8",
    order: 2,
  },
  {
    id: "nonGerman",
    label: `Nichtdeutsch, ${data.votingAge}+*`,
    value: estimatedNonGerman,
    sourceValue: breakdown.nonGermanVotingAgeOrOlder,
    color: "#c8c6c7",
    order: 3,
  },
  ].filter((node) => node.value > 0) : []),
  {
    id: "valid",
    label: `${data.secondVotes.label}${multiVote ? "**" : ""}`,
    value: data.secondVotes.valid,
    voteUnit: true,
    color: "#cad4ed",
    order: 0,
  },
  ...(ballots
    ? [
        {
          id: "ballotsValid",
          label: "Gültige Stimmzettel",
          value: ballots.valid,
          color: "#b9cbe9",
          order: 0,
        },
        {
          id: "ballotsInvalid",
          label: "Ungültige Stimmzettel",
          value: ballots.invalid,
          color: "#d8e2f3",
          order: 1,
          callout: true,
        },
        {
          id: "ballotsNone",
          label: "Kein Stimmzettel",
          value: ballots.none,
          color: "#e4ecf8",
          order: 2,
          callout: true,
        },
      ].filter((node) => node.value > 0)
    : [
        {
          id: "noValid",
          label: noValidLabel,
          value: data.secondVotes.noValidSecondVote ?? 0,
          voteUnit: true,
          color: "#d8e2f3",
          order: 1,
          callout: true,
        },
      ]),
  ...(unusedVotes > 0
    ? [
        {
          id: "unusedVotes",
          label: "Nicht ausgeschöpfte Stimmen",
          value: unusedVotes,
          voteUnit: true,
          color: "#e4ecf8",
          order: 1,
          callout: true,
        },
      ]
    : []),
  ...displayedParties.map((party, order) => ({
    id: `party-${party.name}`,
    label: party.name,
    value: party.votes,
    voteUnit: true,
    color: partyColors[party.name.toLowerCase()] ?? "#76716b",
    order,
  })),
  {
    id: "party-Other",
    label: "Sonstige",
    value: otherVotes,
    voteUnit: true,
    color: "#b2b2b2",
    order: displayedParties.length,
  },
];

const links: DiagramLink[] = [
  { source: "residents", target: "eligible", value: data.eligibility.eligible },
  {
    source: "residents",
    target: "notEligible",
    value: data.eligibility.notEligible,
  },
  { source: "eligible", target: "voters", value: data.turnout.voters },
  { source: "eligible", target: "nonVoters", value: data.turnout.nonVoters },
  ...(breakdown && demographicTotal > 0 ? [
  {
    source: "notEligible",
    target: "underAge",
    value: estimatedUnderAge,
  },
  {
    source: "notEligible",
    target: "nonGerman",
    value: estimatedNonGerman,
  },
  ] : []),
  {
    source: "voters",
    target: ballots ? "ballotsValid" : "valid",
    value: ballots ? ballots.valid : data.secondVotes.valid,
  },
  ...(ballots
    ? [
        {
          source: "voters",
          target: "ballotsInvalid",
          value: ballots.invalid,
        },
        {
          source: "voters",
          target: "ballotsNone",
          value: ballots.none,
        },
        {
          source: "ballotsValid",
          target: "valid",
          value: data.secondVotes.valid,
        },
      ]
    : [
        {
          source: "voters",
          target: "noValid",
          value: data.secondVotes.noValidSecondVote ?? 0,
        },
      ]),
  ...(unusedVotes > 0
    ? [{ source: "ballotsValid", target: "unusedVotes", value: unusedVotes }]
    : []),
  ...displayedParties.map((party) => ({
    source: "valid",
    target: `party-${party.name}`,
    value: party.votes,
  })),
  { source: "valid", target: "party-Other", value: otherVotes },
];

// zero-value links (e.g. Bremen's "Kein Stimmzettel") are dropped with their nodes
const sankeyNodes = nodes.map((node) => ({
  ...node,
  value: node.value / (node.voteUnit ? votesPerVoter : 1),
}));
const layout = sankey<DiagramNode, DiagramLink>()
  .nodeId((node) => node.id)
  .nodeAlign(sankeyLeft)
  .nodeSort((a, b) => a.order - b.order)
  .nodeWidth(14)
  .nodePadding(18)
  .extent([
    [66, 24],
    [850, 696],
  ]);
const graph = layout({
  // Vote capacity shares keep all stages on the population scale; these are not person counts.
  nodes: sankeyNodes,
  links: links
    .filter((link) => link.value > 0)
    .map((link) => ({
      ...link,
      value:
        link.value /
        (nodes.find((node) => node.id === link.target)?.voteUnit
          ? votesPerVoter
          : 1),
    })),
}) as { nodes: LayoutNode[]; links: LayoutLink[] };
if (narrowPartyBands >= 4) {
  let offset = 0;
  graph.nodes.filter((node) => node.id.startsWith("party-")).forEach((node, index) => {
    if (index && partyValues[index - 1] / data.secondVotes.valid < 0.1) offset += 8;
    node.y0 += offset;
    node.y1 += offset;
  });
  layout.update(graph);
}
const path = sankeyLinkHorizontal<DiagramNode, DiagramLink>();
// ponytail: 210px is a rough label-width estimate for "fits right of the node";
// end-anchored callouts stack top-down with a fixed 44px gap
let calloutY = -Infinity;
let startCalloutY = -Infinity;
const callouts = [
  ...graph.nodes
    .filter((node) => node.callout && node.y1 + 210 <= 708)
    .map((node) => {
      const y = Math.max(node.x0 + 7, startCalloutY + 44);
      startCalloutY = y;
      return {
        node,
        anchor: "start" as const,
        x: node.y1 + 12,
        y,
        line: {
          x1: node.y1,
          y1: node.x0 + 3,
          x2: node.y1 + 8,
          y2: y - 4,
        },
      };
    }),
  // ponytail: 210px is a rough label-width estimate for "fits right of the node";
  // end-anchored callouts stack top-down with a fixed 44px gap
  ...graph.nodes
    .filter((node) => node.callout && node.y1 + 210 > 708)
    .sort((a, b) => a.x0 - b.x0)
    .map((node, index) => {
      // place below the previous callout's text, at least 44px apart
      const fallbackY = node.x0 + 34;
      const y = index === 0 ? fallbackY : Math.max(fallbackY, calloutY + 44);
      calloutY = y;
      return {
        node,
        anchor: "end" as const,
        x: 690,
        y,
        line: {
          x1: (node.y0 + node.y1) / 2,
          y1: node.x0,
          x2: 690,
          y2: y - 6,
        },
      };
    }),
];
const sourceLabels: Record<string, string> = {
  results: data.resultStatus === "preliminary" ? "vorläufiges Wahlergebnis" : "endgültiges Wahlergebnis",
  population: "Bevölkerungsstand",
  breakdown: "Bevölkerung nach Altersjahren und Nationalität",
  structure: "Strukturdaten",
  description: "Datensatzbeschreibung",
  summary: "Ergebnisübersicht",
  register: "Melderegister-Auszählung",
  foreign: "ausländische Bevölkerung",
};
const sourceLinks = data.sources.map((source) => ({
  href: source.url,
  label: `${source.publisher}: ${sourceLabels[source.id] ?? source.id}`,
}));
const tableRows = [
  ...nodes.filter((node) => !node.id.startsWith("party-") && node.value > 0)
    .map((node) => node.sourceValue === undefined ? node : {
      ...node,
      label: `${node.label.replace(/\*$/, "")} (Bevölkerungsstatistik)`,
      value: node.sourceValue,
    }),
  ...displayedParties.map((party) => ({
    label: party.name,
    value: party.votes,
    voteUnit: true,
  })),
  {
    label: "Sonstige Parteien",
    value: otherVotes,
    voteUnit: true,
    subtotal: true,
  },
  ...data.secondVotes.parties
    .filter(
      (party) => !displayedParties.some((shown) => shown.name === party.name),
    )
    .map((party) => ({
      label: party.name,
      value: party.votes,
      voteUnit: true,
      minor: true,
    })),
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={`Wie ${state.name} bei der Wahl ${Astro.params.year} gewählt hat.`}
    />
    <title>{`Wer hat gewählt? ${state.name} ${Astro.params.year}`}</title>
    <Font cssVariable="--font-display" />
    <meta
      property="og:title"
      content={`Wer hat gewählt? ${state.name} ${Astro.params.year}`}
    />
    <meta
      property="og:description"
      content={`Wie ${state.name} bei der Wahl ${Astro.params.year} gewählt hat.`}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
    />
    <meta property="og:image" content={new URL(ogCard.src, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content={String(ogCard.width)} />
    <meta property="og:image:height" content={String(ogCard.height)} />
    <meta property="og:image:type" content={ogCard.type} />
    <meta
      property="og:image:alt"
      content={`Sankey-Diagramm der Wahlbeteiligung und Zweitstimmenverteilung in ${state.name} ${Astro.params.year}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body>
    <main>
      <Breadcrumbs
        items={[
          { label: "Startseite", href: "/", home: true },
          { label: state.name, href: `/${Astro.params.state}/` },
          { label: Astro.params.year ?? "" },
        ]}
      />
      <header>
        <div>
          <p class="eyebrow">{data.eyebrow}</p>
          <h1>Wer hat in {state.name} gewählt?</h1>
          <p class="intro">{data.intro}</p>
        </div>
        <label>
          Wahljahr
          <select
            aria-label="Wahljahr auswählen"
          >
            {
              state.years
                .toSorted((a, b) => b - a)
                .map((year) => (
                  <option
                    value={String(year)}
                    selected={String(year) === Astro.params.year}
                  >
                    {year}
                  </option>
                ))
            }
          </select>
        </label>
      </header>

      <section class="status" aria-label="Datenstatus">
        <strong>{resultStatusLabels[data.resultStatus]}</strong>
        <span>Bevölkerungsstand: {populationDate}</span>
      </section>

      <figure>
        <div class="diagram-scroll">
          <svg
            viewBox="0 0 720 940"
            role="img"
            aria-labelledby="diagram-title"
            aria-describedby="diagram-description"
          >
            <title id="diagram-title">
              {
                `Wahlbeteiligung und ${data.secondVotes.label.toLowerCase()} in ${state.name} ${Astro.params.year}`
              }
            </title>
            <desc id="diagram-description">
              {
                `Sankey-Diagramm von ${format.format(data.population.residents)} Einwohner:innen über Wahlberechtigung, Wahlbeteiligung und ${data.secondVotes.label.toLowerCase()} bis zu den Parteien ${topParties} sowie Sonstige.`
              }
            </desc>

            <g transform="matrix(0 1 1 0 0 0)" class="links">
              {
                graph.links.map((link) => (
                  <path
                    d={path(link)}
                    stroke={link.target.color}
                    stroke-width={Math.max(1, link.width)}
                  >
                    <title>
                      {link.source.label} → {link.target.label}:{" "}
                      {nodeValue(link.target, link.value)}
                    </title>
                  </path>
                ))
              }
            </g>

            <g transform="matrix(0 1 1 0 0 0)" class="nodes">
              {
                graph.nodes.map((node) => (
                  <rect
                    x={node.x0}
                    y={node.y0}
                    width={node.x1 - node.x0}
                    height={Math.max(1, node.y1 - node.y0)}
                    fill={node.color}
                  >
                    <title>
                      {node.label}: {nodeValue(node)}
                    </title>
                  </rect>
                ))
              }
            </g>

            <g class="labels" aria-hidden="true">
              {
                // thin adjacent bars: stagger the second label a row higher
                graph.nodes
                  .filter(
                    (node) => !node.callout && !node.id.startsWith("party-"),
                  )
                  .map((node) => (
                    <text
                      text-anchor={node.id === "nonGerman" ? "end" : "start"}
                      y={
                        node.id === "nonGerman"
                          ? node.x0 - 54
                          : node.x0 - 24
                      }
                    >
                      <tspan x={node.id === "nonGerman" ? node.y1 - 3 : node.y0 + 3}>{node.label}</tspan>
                      <tspan x={node.id === "nonGerman" ? node.y1 - 3 : node.y0 + 3} dy="15">
                        {nodeValue(node)}
                      </tspan>
                    </text>
                  ))
              }
              {
                graph.nodes
                  .filter((node) => node.id.startsWith("party-"))
                  .map((node) => (
                    <text
                      x={node.y0 + 3}
                      y={node.x1 + 18}
                      transform={`rotate(35 ${node.y0 + 3} ${node.x1 + 18})`}
                    >
                      <tspan x={node.y0 + 3}>{node.label}</tspan>
                      <tspan x={node.y0 + 3} dy="15">
                        {nodeValue(node)}
                      </tspan>
                    </text>
                  ))
              }
              {
                callouts.map((callout) => (
                  <g>
                    <line
                      x1={callout.line.x1}
                      y1={callout.line.y1}
                      x2={callout.line.x2}
                      y2={callout.line.y2}
                    />
                    <text
                      x={callout.x}
                      y={callout.y}
                      text-anchor={callout.anchor}
                    >
                      <tspan x={callout.x}>{callout.node.label}</tspan>
                      <tspan x={callout.x} dy="17">
                        {nodeValue(callout.node)}
                      </tspan>
                    </text>
                  </g>
                ))
              }
            </g>
          </svg>
        </div>
        <figcaption>
          <ul class="caption-points">
            {breakdown && (
              <li><strong>* Geschätzte Aufteilung:</strong> Anteile aus Bevölkerungsdaten proportional
                auf die rechnerisch nicht Wahlberechtigten verteilt. Annahme: Beide Gruppen decken
                diese vollständig ab.</li>
            )}
            {breakdown && (
              <li><strong>Rundung:</strong> Schätzanteile an allen Einwohner:innen auf ganze Prozent,
                „ca.“-Zahlen auf Tausender. Bänder nutzen ungerundete Werte; Ausgangszahlen stehen
                in der Tabelle.</li>
            )}
            {breakdown && demographicDifference !== 0 && (
              <li><strong>Datenabgleich:</strong> Bevölkerung − Wahlberechtigte − beide Gruppen =
                {" "}{format.format(demographicDifference)} Personen; keine zusätzliche Gruppe.</li>
            )}
            <li><strong>Bevölkerungsdaten:</strong> {data.population.basis}, Stand {populationDate}.
              Alter und Staatsangehörigkeit gelten für diesen Stichtag.</li>
            <li><strong>Parteien:</strong> Mit Mandaten nach voriger oder aktueller Wahl einzeln;
              übrige als „Sonstige“.</li>
            {multiVote && !ballots && <li><strong>** Stimmen:</strong> {data.unitNote} Prozentwerte: Stimmen ÷ ({votesPerVoter} × Einwohnerzahl) × 100; keine Personenanteile.</li>}
          {
            ballots && (
              <li><strong>** Stimmen:</strong> Bis zu {votesPerVoter} je Stimmzettel.
                Ab „{data.secondVotes.label}“: Stimmen ÷ ({votesPerVoter} × Einwohnerzahl) × 100,
                keine Personenanteile. Nicht ausgeschöpft = mögliche − gültige Stimmen auf
                gültigen Stimmzetteln.</li>
            )
          }
          </ul>
          <details class="caption-details">
            <summary>Hinweise zur Datengrundlage</summary>
            <div>
              <p>{data.population.note}</p>
              {data.eligibility.note && <p>{data.eligibility.note}</p>}
              {data.population.demographics.note && <p>{data.population.demographics.note}</p>}
            </div>
          </details>
        </figcaption>
      </figure>

      <details>
        <summary>Daten als Tabelle</summary>
        <div class="table-scroll">
          <table>
            <thead>
              <tr
                ><th>Gruppe</th><th>Anzahl</th><th
                  >{
                    multiVote
                      ? "Anteil an Einwohner:innen / Stimmenpotenzial"
                      : "Anteil an Einwohner:innen"
                  }</th
                ></tr
              >
            </thead>
            <tbody>
              {
                tableRows.map((row) => (
                  <tr
                    class={
                      "minor" in row
                        ? "minor"
                        : "subtotal" in row
                          ? "subtotal"
                          : undefined
                    }
                  >
                    <>
                      <th scope="row">{row.label}</th>
                      <td>
                        {format.format(row.value)}
                        {row.voteUnit && multiVote ? " Stimmen" : ""}
                      </td>
                      <td>
                        {percentage(
                          row.value / (row.voteUnit ? votesPerVoter : 1),
                        )}
                      </td>
                    </>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>

      <footer>
        <p>
          Quellen:{" "}
          {
            sourceLinks.map((link, index) => (
              <>
                {index > 0 &&
                  (index === sourceLinks.length - 1 ? " und " : ", ")}
                <a href={link.href}>{link.label}</a>
              </>
            ))
          }
          .
        </p>
        <p>
          {
            data.ballots
              ? `${format.format(data.ballots.invalid)} ungültige Stimmzettel${
                  data.ballots.none > 0
                    ? `, ${format.format(data.ballots.none)} Wähler:innen ohne Stimmzettel`
                    : ""
                }.`
              : `${noValidLabel}: ${format.format(data.secondVotes.invalid ?? 0)} ungültig und ${format.format(data.secondVotes.noSecondVote ?? 0)} nicht abgegeben.`
          }
        </p>
      </footer>
    </main>
    <script>
      import { navigate } from "astro:transitions/client";

      // Delegated: the select is replaced on every view-transition swap,
      // and this script does not re-run after a swap.
      document.addEventListener("change", (event) => {
        const select = (event.target as Element).closest("header select");
        if (!select || !(select instanceof HTMLSelectElement) || !select.value) return;
        const state = location.pathname.split("/")[1];
        navigate(`/${state}/${select.value}/`);
      });
    </script>
  </body>
</html>

