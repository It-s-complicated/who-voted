---
import RouteIndex from "../../components/RouteIndex.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const elections = await getCollection("elections");
  const grouped = Object.groupBy(elections, ({ data }) => data.state.slug);
  return Object.entries(grouped).map(([state, entries]) => {
    const sorted = entries!.toSorted((a, b) => b.data.electionDate.localeCompare(a.data.electionDate));
    return {
      params: { state },
      props: {
        name: sorted[0].data.state.name,
        years: sorted.map(({ data }) => data.year),
        latestElection: sorted[0].data.electionDate,
      },
    };
  });
}

const { name, years, latestElection } = Astro.props;
const electionDate = new Intl.DateTimeFormat("de-DE", { dateStyle: "long" }).format(new Date(latestElection));
---

<RouteIndex
  title={name}
  description={`Letzte Wahl: ${electionDate}. Wähle ein Wahljahr für die Wahlbeteiligung aus.`}
  breadcrumbs={[{ label: "Startseite", href: "/", home: true }, { label: name }]}
  links={[
    ...years.toSorted((a, b) => b - a).map((year) => ({
      href: `/${Astro.params.state}/${year}/`,
      label: String(year),
      note: "Wahlbeteiligung als Diagramm",
    })),
  ]}
/>
