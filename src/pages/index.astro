---
import RouteIndex from "../components/RouteIndex.astro";
import { states } from "../data/states";
---

<RouteIndex
  title="Wer hat gewählt?"
  description="Wahlbeteiligung im Verhältnis zur Bevölkerung. Wähle ein Bundesland und Wahljahr aus."
  groups={Object.entries(states).map(([state, { name, years }]) => ({
    label: name,
    href: `/${state}/`,
    links: years
      .toSorted((a, b) => b - a)
      .map((year) => ({ href: `/${state}/${year}/`, label: String(year) })),
  }))}
/>
