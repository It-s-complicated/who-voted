---
import RouteIndex from "../components/RouteIndex.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("elections");
const states = Object.values(Object.groupBy(entries, ({ data }) => data.state.slug))
  .map((group) => group![0].data.state)
  .toSorted((a, b) => a.name.localeCompare(b.name, "de-DE"));
const elections = entries.map(({ data }) => ({
  name: data.state.name,
  href: `/${data.state.slug}/${data.year}/`,
  date: data.electionDate,
  year: data.year,
})).toSorted((a, b) => b.date.localeCompare(a.date) || a.name.localeCompare(b.name, "de-DE"));
const newestYear = elections[0].year;
const oldestYear = elections.at(-1)!.year;
const years = Array.from({ length: newestYear - oldestYear + 1 }, (_, i) => newestYear - i);
const dateFormat = new Intl.DateTimeFormat("de-DE", { dateStyle: "long", timeZone: "UTC" });
---

<RouteIndex
  title="Wer hat gewählt?"
  description="Wahlbeteiligung im Verhältnis zur Bevölkerung. Wähle ein Bundesland und Wahljahr aus."
>
  <section class="timeline" aria-label="Wahlen im Zeitverlauf">
    {years.map((year) => (
      <section class="timeline-year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ul class="year-events">
          {Object.entries(Object.groupBy(
            elections.filter((election) => election.year === year),
            (election) => election.date,
          )).map(([date, sameDay]) => (
            <li class="election-date">
              <time datetime={date}>{dateFormat.format(new Date(date))}</time>
              <div class="election-links">
                {sameDay!.map((election) => (
                  <a href={election.href}>{election.name}</a>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
  <nav class="states" aria-label="Bundesländer">
    <h2>Nach Bundesland</h2>
    <ul>
      {states.map(({ slug, name }) => (
        <li><a href={`/${slug}/`}>{name}</a></li>
      ))}
    </ul>
  </nav>
</RouteIndex>

<style>
  .timeline { margin: 2.75rem 0 3.5rem; }
  .timeline-year {
    position: relative;
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    padding: 0.4rem 0 1.75rem;
  }
  .timeline-year:last-child { padding-bottom: 0; }
  .timeline-year::before {
    content: "";
    position: absolute;
    left: 6rem;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--divider);
  }
  .timeline-year:last-child::before { bottom: 1.5rem; }
  .timeline-year h2 {
    position: relative;
    grid-column: 1;
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 620;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .timeline-year h2::after {
    content: "";
    position: absolute;
    right: -0.35rem;
    top: calc(0.85rem - 0.5px);
    width: 0.7rem;
    border-top: 2px solid var(--ink);
  }
  .year-events { grid-column: 2; list-style: none; margin: 0; padding: 0 0 0 1.5rem; }
  .election-date {
    position: relative;
    padding: 0.25rem 0 1.15rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid var(--table-divider);
  }
  .election-date:last-child { margin-bottom: 0; border-bottom: 0; padding-bottom: 0.25rem; }
  .election-date::before {
    content: "";
    position: absolute;
    left: -1.5rem;
    top: 0.85rem;
    width: 0.75rem;
    border-top: 1px solid var(--divider);
  }
  .election-date:first-child::before { content: none; }
  time {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.025em;
  }
  .election-links { display: flex; flex-wrap: wrap; gap: 0.1rem 1.5rem; }
  .election-links a {
    display: inline-block;
    padding: 0.15rem 0;
    font-size: clamp(1.125rem, 2.3vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  @media (max-width: 42rem) {
    .timeline { margin: 2rem 0 2.75rem; }
    .timeline-year { grid-template-columns: 4.75rem minmax(0, 1fr); padding-bottom: 1.25rem; }
    .timeline-year::before { left: 4.75rem; }
    .timeline-year h2 { font-size: 1.35rem; }
    .year-events { padding-left: 1.1rem; }
    .election-date::before { left: -1.1rem; width: 0.55rem; }
    .election-links { gap: 0.15rem 1rem; }
  }
  .states { border-top: 1px solid var(--divider); padding-top: 1.5rem; }
  .states h2 { margin: 0 0 1rem; font-size: 1.125rem; }
  .states ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; list-style: none; margin: 0; padding: 0; }
  .states a { display: inline-block; padding: 0.25rem 0; }
</style>
