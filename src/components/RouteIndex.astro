---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { renderCard } from "astro-cards/runtime";
import "../styles/global.css";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Link {
  href: string;
  label: string;
  note?: string;
}

interface Props {
  title: string;
  description: string;
  links?: Link[];
  groups?: { label: string; href?: string; links: Link[] }[];
  breadcrumbs?: { label: string; href?: string; home?: boolean }[];
}

const { title, description, links, groups, breadcrumbs } = Astro.props;
const ogCard = await renderCard("og", { heading: title });
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} · Wer hat gewählt?</title>
    <Font cssVariable="--font-display" />
    <meta property="og:title" content={`${title} · Wer hat gewählt?`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href}
    />
    <meta property="og:image" content={new URL(ogCard.src, Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content={String(ogCard.width)} />
    <meta property="og:image:height" content={String(ogCard.height)} />
    <meta property="og:image:type" content={ogCard.type} />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
  </head>
  <body>
    <main>
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <header>
        <h1>{title}</h1>
        <p>{description}</p>
      </header>
      <slot />
      {Astro.slots.has("default") ? null : groups ? (
        <ul>
          {groups.map(({ label, href, links: yearLinks }) => (
            <li>
              <a href={href}>{label}</a>
              {yearLinks.map(({ href, label }) => (
                <a class="year" href={href}>{label}</a>
              ))}
            </li>
          ))}
        </ul>
      ) : links && links.length > 0 ? (
        <ul>
          {links.map(({ href, label, note }) => (
            <li><a href={href}>{label}</a>{note && <span>{note}</span>}</li>
          ))}
        </ul>
      ) : (
        <p class="empty">Noch keine Wahljahre verfügbar. Die Wahldaten werden vorbereitet.</p>
      )}
    </main>
  </body>
</html>

<style>
  main { line-height: 1.55; }
  p { max-width: 65ch; margin: 0; color: var(--text-muted); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--divider); }
  li a { font-size: 1.5rem; font-weight: 600; padding: 0.25rem 0; }
  li span { color: var(--text-muted); }
  li a.year { font-size: 1rem; font-weight: 400; }
  .empty { margin-top: 1.5rem; }
</style>
