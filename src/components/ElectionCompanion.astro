---
import { getCollection } from "astro:content";
import ElectionDog from "./ElectionDog.astro";

interface Props { current?: string }
const { current } = Astro.props;
const catalog = (await getCollection("elections")).map(({ id, data }) => ({
  id, name: data.state.name, year: data.year,
}));
---

<election-companion data-catalog={JSON.stringify(catalog)} data-current={current} hidden>
  <section class="companion-shelf" aria-label="Wahlen sammeln">
    <div class="invitation">
      <p class="kicker">Für deinen nächsten Vergleich</p>
      <p class="invitation-title">Eine Wahl kommt selten allein.</p>
      <p class="companion-message" data-message>Du entdeckst die Wahlen. Ich halte sie dir fest.</p>
      {current ? (
        <button type="button" class="collect-button" data-add>
          <span aria-hidden="true">＋</span><span data-add-label>Diese Wahl sammeln</span>
        </button>
      ) : <a class="discover-link" href="/#wahlen">Eine Wahl entdecken <span aria-hidden="true">↗</span></a>}
    </div>
    <button type="button" class="collection-button" data-open aria-haspopup="dialog" aria-controls="election-collection" aria-label="Wahlsammlung öffnen, 0 Wahlen">
      <ElectionDog />
      <span class="collection-label">Sammlung <span class="collection-count" data-count>0</span><span aria-hidden="true">↗</span></span>
    </button>
  </section>
  <p class="sr-only" role="status" aria-live="polite" data-announcement></p>
  <div class="flight-card" data-flight hidden aria-hidden="true">
    <div class="flight-heading"><strong data-flight-year></strong><span data-flight-name></span></div>
    <div class="flight-chart" data-flight-chart></div>
  </div>
  <dialog id="election-collection" aria-labelledby="collection-title">
    <div class="dialog-heading">
      <div><p class="kicker">Gut aufgehoben</p><h2 id="collection-title" tabindex="-1">Deine Wahlsammlung</h2></div>
      <button type="button" class="close-button" data-close aria-label="Sammlung schließen">×</button>
    </div>
    <p class="dialog-intro">Hier warten deine Fundstücke. Wähle eine Wahl, um sie wieder anzusehen.</p>
    <p class="empty-collection" data-empty>Noch nichts gefangen. Sammle eine Wahl auf ihrer Ergebnisseite.</p>
    <ul class="collected-elections" data-list></ul>
    <p class="prototype-note">Der direkte Vergleich nebeneinander kommt als Nächstes. Du kannst deine Wahlen schon sammeln.</p>
    <p class="storage-note" data-storage>Nur in diesem Browser gespeichert. Ohne Anmeldung.</p>
  </dialog>
</election-companion>

<script>
  import { parseCollection } from "../data/comparison";

  interface Election { id: string; name: string; year: number }
  const storageKey = "who-voted:collection:v1";
  let collection: string[] = [];
  let memoryOnly = false;

  class ElectionCompanion extends HTMLElement {
    private catalog: Election[] = [];
    private allowed = new Set<string>();
    private controller?: AbortController;
    private animations: Animation[] = [];
    private frame = 0;
    private carrying = 0;
    private observer?: IntersectionObserver;
    private inView = false;
    private motion = matchMedia("(prefers-reduced-motion: reduce)");
    private storageNote = "Nur in diesem Browser gespeichert. Ohne Anmeldung.";

    private get dialog() { return this.querySelector<HTMLDialogElement>("dialog")!; }
    private get flight() { return this.querySelector<HTMLDivElement>("[data-flight]")!; }

    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.catalog = JSON.parse(this.dataset.catalog!);
      this.allowed = new Set(this.catalog.map(({ id }) => id));
      collection = collection.filter((id) => this.allowed.has(id));
      if (!memoryOnly) {
        try {
          collection = parseCollection(localStorage.getItem(storageKey), this.allowed);
        } catch {
          memoryOnly = true;
        }
      }
      if (memoryOnly) this.storageNote = "Speichern ist gerade nicht möglich. Deine Sammlung bleibt nur während dieser Navigation erhalten.";
      this.render();
      this.hidden = false;
      this.observer = new IntersectionObserver(([entry]) => {
        this.inView = entry.isIntersecting;
        this.updateActivity();
      });
      this.observer.observe(this);
      document.addEventListener("visibilitychange", this.updateActivity, { signal });
      this.updateActivity();
      this.addEventListener("click", this.onClick, { signal });
      document.addEventListener("pointerover", this.look, { signal });
      document.addEventListener("focusin", this.look, { signal });
      window.addEventListener("storage", (event) => {
        if (memoryOnly || (event.key !== storageKey && event.key !== null)) return;
        try {
          collection = parseCollection(event.newValue, this.allowed);
          this.render();
        } catch {
          this.announce("Die gespeicherte Sammlung konnte nicht aktualisiert werden.");
        }
      }, { signal });
      this.motion.addEventListener("change", () => {
        if (this.motion.matches) {
          this.stopFlight();
          this.style.removeProperty("--look-x");
          this.style.removeProperty("--look-y");
          this.style.removeProperty("--head-tilt");
        }
      }, { signal });
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.controller?.abort();
      this.controller = undefined;
      this.stopFlight();
      if (this.dialog.open) this.dialog.close();
    }

    private updateActivity = () => {
      const resting = !this.inView || document.hidden;
      this.classList.toggle("is-resting", resting);
      if (resting) this.stopFlight();
    };

    private announce(message: string) {
      this.querySelector<HTMLElement>("[data-announcement]")!.textContent = message;
    }

    private save() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(collection));
        memoryOnly = false;
        this.storageNote = "Nur in diesem Browser gespeichert. Ohne Anmeldung.";
      } catch {
        memoryOnly = true;
        this.storageNote = "Speichern ist in diesem Browser nicht möglich. Deine Sammlung bleibt nur während dieser Navigation erhalten.";
        this.announce(this.storageNote);
      }
      this.render();
    }

    private render() {
      const list = this.querySelector<HTMLUListElement>("[data-list]")!;
      const focusedIndex = [...list.children].findIndex((item) => item.contains(document.activeElement));
      const focusTarget = document.activeElement instanceof HTMLButtonElement ? "button" : "a";
      list.replaceChildren(...collection.map((id) => {
        const election = this.catalog.find((entry) => entry.id === id)!;
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `/${election.id}/`;
        link.textContent = `${election.name} ${election.year}`;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.dataset.remove = id;
        remove.textContent = "×";
        remove.setAttribute("aria-label", `${link.textContent} aus der Sammlung entfernen`);
        item.append(link, remove);
        return item;
      }));
      this.querySelector<HTMLElement>("[data-count]")!.textContent = String(collection.length);
      this.renderStack();
      this.querySelector<HTMLElement>("[data-open]")!.setAttribute("aria-label", `Wahlsammlung öffnen, ${collection.length} ${collection.length === 1 ? "Wahl" : "Wahlen"}`);
      this.querySelector<HTMLElement>("[data-empty]")!.hidden = collection.length > 0;
      this.querySelector<HTMLElement>("[data-storage]")!.textContent = this.storageNote;
      const add = this.querySelector<HTMLButtonElement>("[data-add]");
      if (add) {
        const selected = collection.includes(this.dataset.current!);
        add.dataset.collected = String(selected);
        add.setAttribute("aria-label", selected ? "Wahl bereits gesammelt. Sammlung öffnen" : "Diese Wahl sammeln");
        add.querySelector("[data-add-label]")!.textContent = selected ? "In deiner Sammlung" : "Diese Wahl sammeln";
        add.firstElementChild!.textContent = selected ? "✓" : "＋";
      }
      if (focusedIndex >= 0) {
        const targets = list.querySelectorAll<HTMLElement>(focusTarget);
        (targets[Math.min(focusedIndex, targets.length - 1)] ?? this.querySelector<HTMLElement>("h2"))?.focus();
      }
    }

    private onClick = (event: MouseEvent) => {
      const target = event.target as Element;
      const button = target.closest<HTMLButtonElement>("button");
      if (button?.hasAttribute("data-open")) {
        this.dialog.showModal();
      } else if (button?.hasAttribute("data-close") || target.closest("dialog a")) {
        this.dialog.close();
      } else if (button?.dataset.remove) {
        const election = this.catalog.find(({ id }) => id === button.dataset.remove)!;
        collection = collection.filter((id) => id !== election.id);
        this.save();
        this.announce(`${election.name} ${election.year} aus der Sammlung entfernt.`);
      } else if (button?.hasAttribute("data-add")) {
        const election = this.catalog.find(({ id }) => id === this.dataset.current);
        if (!election) return;
        if (collection.includes(election.id)) {
          this.dialog.showModal();
          return;
        }
        collection.push(election.id);
        this.save();
        this.querySelector<HTMLElement>("[data-message]")!.textContent = `Hab ich! ${election.name} ${election.year} ist dabei.`;
        this.announce(`${election.name} ${election.year} zur Sammlung hinzugefügt. ${this.storageNote}`);
        void this.catchElection(button, election);
      }
    };

    private look = (event: Event) => {
      if (this.motion.matches || this.classList.contains("is-catching") || this.dialog.open) return;
      const target = (event.target as Element).closest("a, button, select, summary, #election-chart");
      if (!target || target.closest(".collection-button")) return;
      const dog = this.querySelector(".election-dog")!.getBoundingClientRect();
      if (dog.bottom < 0 || dog.top > innerHeight) return;
      const rect = target.getBoundingClientRect();
      const x = clamp((rect.left + rect.width / 2 - dog.left - dog.width * .2) / 120, -2.5, 2.5);
      const y = clamp((rect.top + rect.height / 2 - dog.top - dog.height * .4) / 120, -2, 2);
      this.style.setProperty("--look-x", `${x}px`);
      this.style.setProperty("--look-y", `${y}px`);
      // The dog faces left: a positive turn lifts its nose toward things above it.
      this.style.setProperty("--head-tilt", `${clamp(-y * 3, -5, 6)}deg`);
    };

    /** Cards shown in the basket. One card stays out while the dog is still carrying it. */
    private renderStack() {
      const shown = Math.min(3, Math.max(0, collection.length - this.carrying));
      this.querySelectorAll(".stack-card").forEach((card, index) => card.classList.toggle("is-filled", index < shown));
    }

    private stopFlight() {
      cancelAnimationFrame(this.frame);
      this.animations.forEach((animation) => animation.cancel());
      this.animations = [];
      this.flight.hidden = true;
      this.classList.remove("is-catching");
      this.carrying = 0;
      this.renderStack();
    }

    private prepareCard(election: Election) {
      this.querySelector<HTMLElement>("[data-flight-year]")!.textContent = String(election.year);
      this.querySelector<HTMLElement>("[data-flight-name]")!.textContent = election.name;
      const chart = document.querySelector<SVGSVGElement>("#election-chart")?.cloneNode(true) as SVGSVGElement | undefined;
      const thumbnail = this.querySelector<HTMLDivElement>("[data-flight-chart]")!;
      if (chart) {
        chart.removeAttribute("id");
        chart.removeAttribute("data-filename");
        chart.setAttribute("aria-hidden", "true");
        chart.querySelectorAll("title, desc").forEach((node) => node.remove());
        thumbnail.replaceChildren(chart);
        thumbnail.hidden = false;
      } else {
        thumbnail.replaceChildren();
        thumbnail.hidden = true;
      }
    }

    private async catchElection(button: HTMLButtonElement, election: Election) {
      this.stopFlight();
      if (this.motion.matches || !Element.prototype.animate) return;
      const svg = this.querySelector<SVGSVGElement>(".election-dog")!;
      const head = svg.querySelector<SVGGElement>(".dog-head")!;
      const screen = svg.getScreenCTM();
      if (!screen) return;
      this.prepareCard(election);
      this.carrying = 1;
      this.renderStack();
      this.flight.hidden = false;
      this.classList.add("is-catching");

      // One clock for everything: milliseconds on a 2.8 s timeline, drawing units for distances.
      const T = 2800, RUN = 38, JUMP = 36, CATCH = 1100, DROP = 2340, LANDED_IN_BASKET = 2420;
      const t0 = document.timeline.currentTime as number;
      const track = (frames: [number, string, string?][], property = "transform") =>
        frames.map(([ms, value, easing]) => ({ offset: ms / T, [property]: value, ...(easing ? { easing } : {}) }));
      const play = (selector: string, keyframes: Keyframe[], timing: KeyframeAnimationOptions = {}) => {
        svg.querySelectorAll(selector).forEach((element) => {
          const animation = element.animate(keyframes, { duration: T, ...timing });
          animation.startTime = t0; // delays are part of the timing, so every part shares one clock
          this.animations.push(animation);
        });
      };
      const pose = (x: number, y: number, facing: number, turn: number) =>
        `translate(${x}px, ${y}px) scale(${facing}, 1) rotate(${turn}deg)`;
      const out = "cubic-bezier(.2,.7,.4,1)", fall = "cubic-bezier(.5,0,.8,.6)", step = "ease-in-out";
      const R = RUN, J = JUMP, L = RUN + 8;

      // Whole dog: anticipation, run, jump, catch, land, turn, trot home, turn back.
      const actor = track([
        [0, pose(0, 0, 1, 0), step], [160, pose(3, 0, 1, -2), "ease-in"],
        [700, pose(-R, 0, 1, 0)], [820, pose(-R - 2, 0, 1, -3), out],
        [CATCH, pose(-R - 6, -J, 1, 5)], [1200, pose(-R - 7, -J + 3, 1, -1), fall],
        [1380, pose(-L, 0, 1, -5), out], [1480, pose(-L, 0, 1, 0)],
        // Turning is a little spin-hop, so the mirrored frames read as a turn, not a flicker.
        [1520, pose(-L, 0, 1, 0), out], [1590, pose(-L, -7, 0, 0), "ease-in"], [1660, pose(-L, 0, -1, 0)],
        [2160, pose(0, 0, -1, 0)], [2440, pose(0, 0, -1, 0), out],
        [2510, pose(0, -6, 0, 0), "ease-in"], [2580, pose(0, 0, 1, 0)], [T, pose(0, 0, 1, 0)],
      ]);
      play(".dog-actor", actor);
      const squash = (y: number, sx: number, sy: number) => `translateY(${y}px) scale(${sx}, ${sy})`;
      play(".dog-breath", track([
        [0, squash(0, 1, 1)], [140, squash(1, 1.05, .92)], [240, squash(-1, .97, 1.04)],
        [370, squash(-3, 1, 1)], [480, squash(0, 1.02, .98)], [590, squash(-3, 1, 1)], [700, squash(0, 1, 1)],
        [820, squash(1, 1.08, .88), out], [920, squash(-1, .94, 1.08)], [CATCH, squash(0, 1, 1)],
        [1380, squash(0, 1, 1), out], [1430, squash(1, 1.1, .86)], [1520, squash(-1, .97, 1.04)], [1600, squash(0, 1, 1)],
        [1720, squash(-2, 1, 1)], [1785, squash(0, 1, 1)], [1850, squash(-2, 1, 1)], [1910, squash(0, 1, 1)],
        [1975, squash(-2, 1, 1)], [2040, squash(0, 1, 1)], [2100, squash(-2, 1, 1)], [2160, squash(0, 1, 1)],
        [2280, squash(1, 1.03, .96)], [2440, squash(0, 1, 1)],
        [2600, squash(1, 1.04, .95)], [2700, squash(-1, .99, 1.02)], [T, squash(0, 1, 1)],
      ]));
      play(".dog-shadow", track([
          [0, "translateX(0) scale(1)"], [160, "translateX(3px) scale(1)"], [700, `translateX(-${R}px) scale(1)`],
          [820, `translateX(-${R + 2}px) scale(1.05)`, out], [CATCH, `translateX(-${R + 6}px) scale(.5)`],
          [1200, `translateX(-${R + 7}px) scale(.52)`, fall], [1380, `translateX(-${L}px) scale(1.1)`],
          [1480, `translateX(-${L}px) scale(1)`], [1660, `translateX(-${L}px) scale(1)`],
          [2160, "translateX(0) scale(1)"], [T, "translateX(0) scale(1)"],
      ]));
      play(".dog-shadow", track([[0, ".13"], [820, ".13", out], [CATCH, ".06"], [1200, ".06", fall], [1380, ".16"], [1520, ".13"], [T, ".13"]], "opacity"));

      // Gallop out (two strides), leap, then a trot home on diagonal pairs.
      const gait = (amplitude: number, phase: 1 | -1) => [
        { transform: "rotate(0deg)" }, { transform: `rotate(${amplitude * phase}deg)` },
        { transform: `rotate(${-amplitude * phase}deg)` }, { transform: "rotate(0deg)" },
      ];
      const legs = { frontNear: ".dog-front-near", frontFar: ".dog-front-far", hindNear: ".dog-hind-near", hindFar: ".dog-hind-far" };
      const gallop = { duration: 220, iterations: 2, delay: 260, easing: step };
      play(legs.frontNear, gait(30, 1), gallop);
      play(legs.frontFar, gait(26, 1), { ...gallop, delay: 290 });
      play(legs.hindNear, gait(28, -1), { ...gallop, delay: 300 });
      play(legs.hindFar, gait(24, -1), { ...gallop, delay: 270 });
      const leap = (frames: [number, number][]) => frames.map(([ms, angle]) => ({ offset: (ms - 700) / 780, transform: `rotate(${angle}deg)` }));
      const leapTiming = { duration: 780, delay: 700, easing: "linear" };
      const front = leap([[700, 0], [820, -12], [920, 48], [CATCH, 28], [1280, 18], [1380, -6], [1480, 0]]);
      const hind = leap([[700, 0], [820, 10], [920, -52], [CATCH, 22], [1280, 8], [1380, 2], [1480, 0]]);
      play(`${legs.frontNear}, ${legs.frontFar}`, front, leapTiming);
      play(`${legs.hindNear}, ${legs.hindFar}`, hind, leapTiming);
      const trot = { duration: 250, iterations: 2, delay: 1660, easing: step };
      play(`${legs.frontNear}, ${legs.hindFar}`, gait(20, 1), trot);
      play(`${legs.frontFar}, ${legs.hindNear}`, gait(20, -1), trot);

      play(".dog-head", track([
        [0, "rotate(0deg)"], [150, "rotate(8deg)"], [260, "rotate(4deg)"], [700, "rotate(2deg)"],
        [820, "rotate(-4deg)", out], [980, "rotate(16deg)"], [CATCH, "rotate(9deg)"], [1180, "rotate(3deg)"],
        [1380, "rotate(-8deg)"], [1480, "rotate(4deg)"], [1560, "rotate(0deg)"], [2160, "rotate(0deg)", step],
        [2300, "rotate(-20deg)"], [DROP + 60, "rotate(-21deg)", out], [2500, "rotate(4deg)"],
        [2640, "rotate(10deg) translateY(-1px)", step], [T, "rotate(0deg)"],
      ]));
      // Soft parts lag behind the body and overshoot when it stops.
      play(".dog-ear-near", track([
        [0, "rotate(0deg)"], [140, "rotate(-4deg)"], [260, "rotate(6deg)"], [480, "rotate(-8deg)"], [700, "rotate(6deg)"],
        [820, "rotate(10deg)"], [960, "rotate(-22deg)"], [1160, "rotate(-36deg)"], [1380, "rotate(16deg)"],
        [1460, "rotate(-10deg)"], [1540, "rotate(5deg)"], [1620, "rotate(0deg)"], [1900, "rotate(-6deg)"],
        [2160, "rotate(0deg)"], [2300, "rotate(14deg)"], [DROP + 80, "rotate(10deg)"], [2500, "rotate(-8deg)"],
        [2620, "rotate(4deg)"], [T, "rotate(0deg)"],
      ], "transform"), { easing: "linear" });
      play(".dog-ear-far", track([
        [0, "rotate(0deg)"], [820, "rotate(4deg)"], [960, "rotate(-12deg)"], [1160, "rotate(-22deg)"],
        [1380, "rotate(10deg)"], [1460, "rotate(-5deg)"], [1620, "rotate(0deg)"], [2300, "rotate(8deg)"],
        [2500, "rotate(-4deg)"], [T, "rotate(0deg)"],
      ]));
      play(".dog-tag", track([
        [0, "rotate(0deg)"], [700, "rotate(-12deg)"], [960, "rotate(-28deg)"], [1160, "rotate(18deg)"],
        [1380, "rotate(-26deg)"], [1460, "rotate(20deg)"], [1540, "rotate(-10deg)"], [1640, "rotate(4deg)"],
        [2160, "rotate(-8deg)"], [2300, "rotate(16deg)"], [2440, "rotate(-8deg)"], [2560, "rotate(4deg)"], [T, "rotate(0deg)"],
      ]));
      play(".dog-tail", [{ transform: "rotate(-14deg)" }, { transform: "rotate(18deg)" }], { duration: 175, iterations: 16, direction: "alternate", easing: step });
      // Swap drawings (open/closed mouth, open/happy eyes) during the given windows.
      const during = (ranges: [number, number][], on = "1", off = "0") => {
        const frames: [number, string][] = [[0, off]];
        for (const [from, to] of ranges) frames.push([from, off], [from + 30, on], [to - 30, on], [to, off]);
        frames.push([T, off]);
        return track(frames, "opacity");
      };
      const show = (ranges: [number, number][]) => during(ranges);
      const hide = (ranges: [number, number][]) => during(ranges, "0", "1");
      play(".dog-mouth-open", show([[930, CATCH + 10], [DROP - 20, DROP + 110]]));
      play(".dog-mouth-closed", hide([[930, CATCH + 10], [DROP - 20, DROP + 110]]));
      play(".dog-eyes-happy", show([[2470, T]]));
      play(".dog-eyes-open", hide([[2470, T]]));
      play(".dog-eyes", track([[0, "translate(0, 0)"], [150, "translate(-1px, -2px)"], [CATCH, "translate(-1px, -2px)"], [1220, "translate(0, 0)"], [T, "translate(0, 0)"]]));
      play(".dog-basket", track([
        [0, "scale(1, 1)"], [LANDED_IN_BASKET, "scale(1, 1)"], [LANDED_IN_BASKET + 50, "scale(1.07, .88)"],
        [LANDED_IN_BASKET + 130, "scale(.97, 1.05)"], [LANDED_IN_BASKET + 210, "scale(1, 1)"], [T, "scale(1, 1)"],
      ]));

      // The card is one object for the whole trip. Each frame it is placed from the dog's
      // live transform (on the actor's clock), so the chart meets the muzzle exactly and stays in the mouth.
      // Geometry is read live, so scrolling mid-throw cannot detach the card from the dog.
      const origin = () => {
        const source = button.getBoundingClientRect();
        return { x: source.left + source.width / 2, y: source.top + source.height / 2 };
      };
      const inDrawing = (x: number, y: number) => new DOMPoint(x, y).matrixTransform(svg.getScreenCTM() ?? screen);
      const start = origin();
      const unit = screen.a;
      const card = { width: 132, height: 112 };
      const held = (30 * unit) / card.width;
      const inBasket = (20 * unit) / card.width;
      let last = { x: start.x, y: start.y, angle: 0 };
      const mouth = () => {
        const matrix = head.getScreenCTM();
        if (!matrix) return last;
        const point = new DOMPoint(21, 97).matrixTransform(matrix);
        // atan2(-c, d) is the head's rotation whether or not the dog is mirrored.
        return (last = { x: point.x, y: point.y, angle: Math.atan2(-matrix.c, matrix.d) * 180 / Math.PI });
      };
      const lift = clamp(70 + Math.abs(inDrawing(21 - RUN - 6, 97 - JUMP).x - start.x) * .18, 80, 170);
      let dropFrom: { x: number; y: number; angle: number } | undefined;
      const place = (x: number, y: number, scale: number, angle: number, opacity: number) => {
        this.flight.style.transform = `translate(${x - card.width / 2}px, ${y - card.height / 2}px) rotate(${angle}deg) scale(${scale})`;
        this.flight.style.opacity = String(opacity);
      };
      const [master] = this.animations;
      const tick = () => {
        const t = Number(master.currentTime ?? T);
        if (t < CATCH) {
          const u = Math.max(0, t / CATCH);
          const target = mouth();
          const from = origin();
          const peak = inDrawing(21 - RUN - 6, 97 - JUMP);
          const control = { x: (from.x + peak.x) / 2, y: Math.max(8, Math.min(from.y, peak.y) - lift) };
          const x = (1 - u) ** 2 * from.x + 2 * u * (1 - u) * control.x + u ** 2 * target.x;
          const y = (1 - u) ** 2 * from.y + 2 * u * (1 - u) * control.y + u ** 2 * target.y;
          const grow = u < .45 ? .5 + .5 * Math.sin((u / .45) * Math.PI / 2) : 1 - (1 - held) * ((u - .45) / .55) ** 1.6;
          const spin = u < .5 ? -12 + 40 * u : 8 + (target.angle - 6 - 8) * ((u - .5) / .5);
          place(x, y, grow, spin, Math.min(1, t / 80));
        } else if (t < DROP) {
          const { x, y, angle } = mouth();
          place(x, y, held, angle - 6, 1);
          dropFrom = { x, y, angle: angle - 6 };
        } else if (t < LANDED_IN_BASKET + 40 && dropFrom) {
          const u = (t - DROP) / (LANDED_IN_BASKET + 40 - DROP);
          const basket = inDrawing(212, 112);
          const x = dropFrom.x + (basket.x - dropFrom.x) * u;
          const y = dropFrom.y + (basket.y - dropFrom.y) * u * u - 10 * unit * Math.sin(u * Math.PI);
          place(x, y, held + (inBasket - held) * u, dropFrom.angle * (1 - u) + 4 * u, u < .75 ? 1 : (1 - u) * 4);
          if (t >= LANDED_IN_BASKET && this.carrying) {
            this.carrying = 0;
            this.renderStack();
          }
        } else {
          this.flight.hidden = true;
          if (this.carrying) {
            this.carrying = 0;
            this.renderStack();
          }
        }
        if (t < T) this.frame = requestAnimationFrame(tick);
      };
      tick();

      try {
        await master.finished;
      } catch (error) {
        if (!(error instanceof DOMException && error.name === "AbortError")) console.error("Catch animation failed", error);
      } finally {
        if (this.animations.includes(master)) this.stopFlight();
      }
    }
  }

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  customElements.define("election-companion", ElectionCompanion);
</script>

