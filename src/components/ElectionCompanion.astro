---
import { getCollection } from "astro:content";
import ElectionDog from "./ElectionDog.astro";

interface Props { current?: string }
const { current } = Astro.props;
const catalog = (await getCollection("elections")).map(({ id, data }) => ({
  id, name: data.state.name, year: data.year,
}));
---

<election-companion data-catalog={JSON.stringify(catalog)} data-current={current} hidden>
  <section class="companion-shelf" aria-label="Wahlen sammeln">
    <div class="invitation">
      <p class="kicker">Für deinen nächsten Vergleich</p>
      <p class="invitation-title">Eine Wahl kommt selten allein.</p>
      <p class="companion-message" data-message>Du entdeckst die Wahlen. Ich halte sie dir fest.</p>
      {current ? (
        <button type="button" class="collect-button" data-add>
          <span aria-hidden="true">＋</span><span data-add-label>Diese Wahl sammeln</span>
        </button>
      ) : <a class="discover-link" href="/#wahlen">Eine Wahl entdecken <span aria-hidden="true">↗</span></a>}
    </div>
    <button type="button" class="collection-button" data-open aria-haspopup="dialog" aria-controls="election-collection" aria-label="Wahlsammlung öffnen, 0 Wahlen">
      <ElectionDog />
      <span class="catch-burst" aria-hidden="true"><i>✦</i><i>★</i><i>✦</i></span>
      <span class="play-spark" aria-hidden="true">✦</span>
      <span class="collection-label">Sammlung <span class="collection-count" data-count>0</span><span aria-hidden="true">↗</span></span>
    </button>
  </section>
  <p class="sr-only" role="status" aria-live="polite" data-announcement></p>
  <div class="flight-card" data-flight hidden aria-hidden="true">
    <div class="flight-heading"><strong data-flight-year></strong><span data-flight-name></span></div>
    <div class="flight-chart" data-flight-chart></div>
  </div>
  <dialog id="election-collection" aria-labelledby="collection-title">
    <div class="dialog-heading">
      <div><p class="kicker">Gut aufgehoben</p><h2 id="collection-title" tabindex="-1">Deine Wahlsammlung</h2></div>
      <button type="button" class="close-button" data-close aria-label="Sammlung schließen">×</button>
    </div>
    <p class="dialog-intro">Hier warten deine Fundstücke. Wähle eine Wahl, um sie wieder anzusehen.</p>
    <p class="empty-collection" data-empty>Noch nichts gefangen. Sammle eine Wahl auf ihrer Ergebnisseite.</p>
    <ul class="collected-elections" data-list></ul>
    <p class="prototype-note">Der direkte Vergleich nebeneinander kommt als Nächstes. Du kannst deine Wahlen schon sammeln.</p>
    <p class="storage-note" data-storage>Nur in diesem Browser gespeichert. Ohne Anmeldung.</p>
  </dialog>
</election-companion>

<script>
  import { parseCollection } from "../data/comparison";

  interface Election { id: string; name: string; year: number }
  const storageKey = "who-voted:collection:v1";
  let collection: string[] = [];
  let memoryOnly = false;

  class ElectionCompanion extends HTMLElement {
    private catalog: Election[] = [];
    private allowed = new Set<string>();
    private controller?: AbortController;
    private animations: Animation[] = [];
    private motion = matchMedia("(prefers-reduced-motion: reduce)");
    private storageNote = "Nur in diesem Browser gespeichert. Ohne Anmeldung.";

    private get dialog() { return this.querySelector<HTMLDialogElement>("dialog")!; }
    private get flight() { return this.querySelector<HTMLDivElement>("[data-flight]")!; }

    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const { signal } = this.controller;
      this.catalog = JSON.parse(this.dataset.catalog!);
      this.allowed = new Set(this.catalog.map(({ id }) => id));
      collection = collection.filter((id) => this.allowed.has(id));
      if (!memoryOnly) {
        try {
          collection = parseCollection(localStorage.getItem(storageKey), this.allowed);
        } catch {
          memoryOnly = true;
        }
      }
      if (memoryOnly) this.storageNote = "Speichern ist gerade nicht möglich. Deine Sammlung bleibt nur während dieser Navigation erhalten.";
      this.render();
      this.hidden = false;
      this.addEventListener("click", this.onClick, { signal });
      document.addEventListener("pointerover", this.look, { signal });
      document.addEventListener("focusin", this.look, { signal });
      window.addEventListener("storage", (event) => {
        if (memoryOnly || (event.key !== storageKey && event.key !== null)) return;
        try {
          collection = parseCollection(event.newValue, this.allowed);
          this.render();
        } catch {
          this.announce("Die gespeicherte Sammlung konnte nicht aktualisiert werden.");
        }
      }, { signal });
      this.motion.addEventListener("change", () => {
        if (this.motion.matches) {
          this.stopFlight();
          this.style.removeProperty("--look-x");
          this.style.removeProperty("--look-y");
          this.style.removeProperty("--head-tilt");
        }
      }, { signal });
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.controller = undefined;
      this.stopFlight();
      if (this.dialog.open) this.dialog.close();
    }

    private announce(message: string) {
      this.querySelector<HTMLElement>("[data-announcement]")!.textContent = message;
    }

    private save() {
      try {
        localStorage.setItem(storageKey, JSON.stringify(collection));
        memoryOnly = false;
        this.storageNote = "Nur in diesem Browser gespeichert. Ohne Anmeldung.";
      } catch {
        memoryOnly = true;
        this.storageNote = "Speichern ist in diesem Browser nicht möglich. Deine Sammlung bleibt nur während dieser Navigation erhalten.";
        this.announce(this.storageNote);
      }
      this.render();
    }

    private render() {
      const list = this.querySelector<HTMLUListElement>("[data-list]")!;
      const focusedIndex = [...list.children].findIndex((item) => item.contains(document.activeElement));
      const focusTarget = document.activeElement instanceof HTMLButtonElement ? "button" : "a";
      list.replaceChildren(...collection.map((id) => {
        const election = this.catalog.find((entry) => entry.id === id)!;
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `/${election.id}/`;
        link.textContent = `${election.name} ${election.year}`;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.dataset.remove = id;
        remove.textContent = "×";
        remove.setAttribute("aria-label", `${link.textContent} aus der Sammlung entfernen`);
        item.append(link, remove);
        return item;
      }));
      this.querySelector<HTMLElement>("[data-count]")!.textContent = String(collection.length);
      this.querySelector<HTMLElement>("[data-open]")!.setAttribute("aria-label", `Wahlsammlung öffnen, ${collection.length} ${collection.length === 1 ? "Wahl" : "Wahlen"}`);
      this.querySelector<HTMLElement>("[data-empty]")!.hidden = collection.length > 0;
      this.querySelector<HTMLElement>("[data-storage]")!.textContent = this.storageNote;
      const add = this.querySelector<HTMLButtonElement>("[data-add]");
      if (add) {
        const selected = collection.includes(this.dataset.current!);
        add.dataset.collected = String(selected);
        add.setAttribute("aria-label", selected ? "Wahl bereits gesammelt. Sammlung öffnen" : "Diese Wahl sammeln");
        add.querySelector("[data-add-label]")!.textContent = selected ? "In deiner Sammlung" : "Diese Wahl sammeln";
        add.firstElementChild!.textContent = selected ? "✓" : "＋";
      }
      if (focusedIndex >= 0) {
        const targets = list.querySelectorAll<HTMLElement>(focusTarget);
        (targets[Math.min(focusedIndex, targets.length - 1)] ?? this.querySelector<HTMLElement>("h2"))?.focus();
      }
    }

    private onClick = (event: MouseEvent) => {
      const target = event.target as Element;
      const button = target.closest<HTMLButtonElement>("button");
      if (button?.hasAttribute("data-open")) {
        this.dialog.showModal();
      } else if (button?.hasAttribute("data-close") || target.closest("dialog a")) {
        this.dialog.close();
      } else if (button?.dataset.remove) {
        const election = this.catalog.find(({ id }) => id === button.dataset.remove)!;
        collection = collection.filter((id) => id !== election.id);
        this.save();
        this.announce(`${election.name} ${election.year} aus der Sammlung entfernt.`);
      } else if (button?.hasAttribute("data-add")) {
        const election = this.catalog.find(({ id }) => id === this.dataset.current);
        if (!election) return;
        if (collection.includes(election.id)) {
          this.dialog.showModal();
          return;
        }
        collection.push(election.id);
        this.save();
        this.querySelector<HTMLElement>("[data-message]")!.textContent = `Hab ich! ${election.name} ${election.year} ist dabei.`;
        this.announce(`${election.name} ${election.year} zur Sammlung hinzugefügt. ${this.storageNote}`);
        void this.catchElection(button, election);
      }
    };

    private look = (event: Event) => {
      if (this.motion.matches || this.classList.contains("is-catching") || this.dialog.open) return;
      const target = (event.target as Element).closest("a, button, select, summary, #election-chart");
      if (!target) return;
      const dog = this.querySelector("svg")!.getBoundingClientRect();
      if (dog.bottom < 0 || dog.top > innerHeight) return;
      const rect = target.getBoundingClientRect();
      const x = Math.max(-3, Math.min(3, (rect.left + rect.width / 2 - dog.left - dog.width / 2) / 100));
      const y = Math.max(-2, Math.min(2, (rect.top + rect.height / 2 - dog.top - dog.height / 2) / 100));
      this.style.setProperty("--look-x", `${x}px`);
      this.style.setProperty("--look-y", `${y}px`);
      this.style.setProperty("--head-tilt", `${x * 1.5}deg`);
    };

    private stopFlight() {
      this.animations.forEach((animation) => animation.cancel());
      this.animations = [];
      this.flight.hidden = true;
      this.classList.remove("is-catching");
    }

    private async catchElection(button: HTMLButtonElement, election: Election) {
      this.stopFlight();
      if (this.motion.matches || !Element.prototype.animate) return;
      const dog = this.querySelector<SVGSVGElement>("svg")!;
      const source = button.getBoundingClientRect();
      const destination = dog.getBoundingClientRect();
      const duration = 1900;
      const run = Math.min(48, destination.width * .25);
      const jump = Math.min(54, destination.height * .43);
      const card = { width: 132, height: 112 };
      const mouth = {
        x: destination.left + destination.width * (62 / 290) - run - 4,
        y: destination.top + destination.height * (97 / 175) - jump,
      };
      const start = {
        x: source.left + source.width / 2 - card.width / 2,
        y: source.top + source.height / 2 - card.height / 2,
      };
      const end = { x: mouth.x - card.width / 2, y: mouth.y - card.height / 2 };
      const dx = end.x - start.x;
      const arc = Math.max(8, Math.min(start.y, end.y) - Math.min(110, Math.abs(dx) * .42 + 48));

      this.querySelector<HTMLElement>("[data-flight-year]")!.textContent = String(election.year);
      this.querySelector<HTMLElement>("[data-flight-name]")!.textContent = election.name;
      const chart = document.querySelector<SVGSVGElement>("#election-chart")?.cloneNode(true) as SVGSVGElement | undefined;
      const thumbnail = this.querySelector<HTMLDivElement>("[data-flight-chart]")!;
      if (chart) {
        chart.removeAttribute("id");
        chart.removeAttribute("data-filename");
        chart.setAttribute("aria-hidden", "true");
        thumbnail.replaceChildren(chart);
        thumbnail.hidden = false;
      } else {
        thumbnail.replaceChildren();
        thumbnail.hidden = true;
      }

      this.flight.hidden = false;
      this.classList.add("is-catching");
      const flight = this.flight.animate([
        { transform: `translate(${start.x}px, ${start.y + 4}px) scale(.58) rotate(-12deg)`, opacity: 0, offset: 0 },
        { transform: `translate(${start.x + dx * .06}px, ${start.y - 15}px) scale(.82) rotate(-14deg)`, opacity: 1, offset: .07 },
        { transform: `translate(${start.x + dx * .43}px, ${arc}px) scale(1.04) rotate(10deg)`, opacity: 1, offset: .38 },
        { transform: `translate(${end.x}px, ${end.y}px) scale(.4) rotate(-7deg)`, opacity: 1, offset: .63 },
        { transform: `translate(${end.x}px, ${end.y}px) scale(.14) rotate(3deg)`, opacity: 1, offset: .68 },
        { transform: `translate(${end.x}px, ${end.y}px) scale(.06)`, opacity: 0, offset: .73 },
        { transform: `translate(${end.x}px, ${end.y}px) scale(.06)`, opacity: 0, offset: 1 },
      ], { duration, easing: "cubic-bezier(.2,.75,.25,1)" });
      const actor = dog.querySelector(".dog-actor")!.animate([
        { transform: "translate(0, 0) rotate(0deg)", offset: 0 },
        { transform: "translate(3px, 7px) scale(1.07, .9) rotate(-4deg)", offset: .08 },
        { transform: "translate(-2px, -5px) scale(.98, 1.04) rotate(2deg)", offset: .13 },
        { transform: `translate(-${run * .55}px, 0) rotate(-2deg)`, offset: .25 },
        { transform: `translate(-${run}px, 0) rotate(1deg)`, offset: .35 },
        { transform: `translate(-${run}px, 6px) scale(1.06, .91) rotate(-5deg)`, offset: .43 },
        { transform: `translate(-${run + 4}px, -${jump}px) scale(.98, 1.03) rotate(6deg)`, offset: .58 },
        { transform: `translate(-${run + 4}px, -${jump}px) rotate(4deg)`, offset: .67 },
        { transform: `translate(-${run}px, 0) rotate(-3deg)`, offset: .77 },
        { transform: `translate(-${run}px, 7px) scale(1.09, .88) rotate(-2deg)`, offset: .82 },
        { transform: `translate(-${run}px, -4px) scale(.98, 1.03) rotate(1deg)`, offset: .87 },
        { transform: `translate(-${run * .55}px, 0) rotate(-2deg)`, offset: .94 },
        { transform: "translate(0, 0) rotate(0deg)", offset: 1 },
      ], { duration });
      const head = dog.querySelector(".dog-head")!.animate([
        { transform: "rotate(-5deg)", offset: 0 },
        { transform: "rotate(10deg) translateY(2px)", offset: .1 },
        { transform: "rotate(-4deg)", offset: .34 },
        { transform: "rotate(20deg) translateY(-2px)", offset: .53 },
        { transform: "rotate(23deg)", offset: .66 },
        { transform: "rotate(-9deg) translateY(2px)", offset: .8 },
        { transform: "rotate(3deg)", offset: .89 },
        { transform: "rotate(-5deg)", offset: 1 },
      ], { duration });
      const shadow = dog.querySelector(".dog-shadow")!.animate([
        { transform: "translateX(0) scale(1)", opacity: .11, offset: 0 },
        { transform: `translateX(-${run * .8}px) scale(.85)`, opacity: .09, offset: .4 },
        { transform: `translateX(-${run}px) scale(.42)`, opacity: .04, offset: .62 },
        { transform: `translateX(-${run}px) scale(1.14)`, opacity: .15, offset: .8 },
        { transform: `translateX(-${run}px) scale(1)`, opacity: .11, offset: .87 },
        { transform: "translateX(0) scale(1)", opacity: .11, offset: 1 },
      ], { duration });
      const openMouth = dog.querySelector(".dog-mouth-open")!.animate([
        { opacity: 0, offset: 0 }, { opacity: 0, offset: .43 },
        { opacity: 1, offset: .48 }, { opacity: 1, offset: .69 },
        { opacity: 0, offset: .76 }, { opacity: 0, offset: 1 },
      ], { duration });
      const closedMouth = dog.querySelector(".dog-mouth-closed")!.animate([
        { opacity: 1, offset: 0 }, { opacity: 1, offset: .43 },
        { opacity: 0, offset: .48 }, { opacity: 0, offset: .69 },
        { opacity: 1, offset: .76 }, { opacity: 1, offset: 1 },
      ], { duration });
      const legs = [...dog.querySelectorAll(".dog-leg")].map((leg, index) => {
        const direction = index % 2 === 0 ? 1 : -1;
        const tuck = leg.classList.contains("dog-front-near") || leg.classList.contains("dog-front-far") ? -38 : 42;
        return leg.animate([
          { transform: "rotate(0deg)", offset: 0 },
          { transform: `rotate(${18 * direction}deg)`, offset: .08 },
          { transform: `rotate(${-42 * direction}deg)`, offset: .16 },
          { transform: `rotate(${42 * direction}deg)`, offset: .24 },
          { transform: `rotate(${-38 * direction}deg)`, offset: .32 },
          { transform: `rotate(${28 * direction}deg)`, offset: .4 },
          { transform: `rotate(${tuck * 1.2}deg)`, offset: .54 },
          { transform: `rotate(${tuck * 1.2}deg)`, offset: .67 },
          { transform: `rotate(${-22 * direction}deg)`, offset: .77 },
          { transform: `rotate(${12 * direction}deg)`, offset: .83 },
          { transform: "rotate(0deg)", offset: .88 },
          { transform: `rotate(${28 * direction}deg)`, offset: .95 },
          { transform: "rotate(0deg)", offset: 1 },
        ], { duration });
      });
      const ears = [...dog.querySelectorAll(".dog-ear")].map((ear, index) => ear.animate([
        { transform: "rotate(0deg)", offset: 0 },
        { transform: `rotate(${index ? -14 : 11}deg)`, offset: .25 },
        { transform: `rotate(${index ? 22 : -16}deg)`, offset: .43 },
        { transform: `rotate(${index ? -32 : 24}deg)`, offset: .62 },
        { transform: `rotate(${index ? 15 : -11}deg)`, offset: .79 },
        { transform: "rotate(0deg)", offset: 1 },
      ], { duration }));
      const tail = dog.querySelector(".dog-tail")!.animate([
        { transform: "rotate(0deg)", offset: 0 },
        { transform: "rotate(-20deg)", offset: .1 },
        { transform: "rotate(20deg)", offset: .2 },
        { transform: "rotate(-20deg)", offset: .3 },
        { transform: "rotate(20deg)", offset: .4 },
        { transform: "rotate(-18deg)", offset: .52 },
        { transform: "rotate(17deg)", offset: .64 },
        { transform: "rotate(-12deg)", offset: .76 },
        { transform: "rotate(10deg)", offset: .88 },
        { transform: "rotate(0deg)", offset: 1 },
      ], { duration });
      this.animations = [flight, actor, head, shadow, openMouth, closedMouth, tail, ...legs, ...ears];
      try {
        await flight.finished;
      } catch (error) {
        if (!(error instanceof DOMException && error.name === "AbortError")) console.error("Catch animation failed", error);
      } finally {
        if (this.animations.includes(flight)) this.stopFlight();
      }
    }
  }

  customElements.define("election-companion", ElectionCompanion);
</script>

<style>
  election-companion { display: block; margin: 1.6rem 0 1.5rem; }
  election-companion[hidden], [hidden] { display: none !important; }
  .companion-shelf { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 12rem; align-items: end; gap: 1rem; overflow: hidden; border: 1.5px solid var(--ink); border-radius: 22px; background: #fff3d6; box-shadow: 4px 5px 0 #1c1b1a12; }
  .companion-shelf::before { content: ""; position: absolute; width: 11rem; height: 11rem; right: -4rem; top: -6rem; border: 1.5px dashed #d99b2b66; border-radius: 50%; pointer-events: none; }
  .invitation { position: relative; z-index: 1; padding: 1.25rem 0 1.45rem 1.5rem; }
  .kicker { margin: 0 0 .45rem; color: var(--primary); font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .invitation-title { margin: 0; font: 620 1.6rem/1.15 var(--font-display); letter-spacing: -.02em; }
  .companion-message { margin: .55rem 0 1rem; color: var(--text-muted); font-size: .88rem; line-height: 1.5; }
  button { color: var(--ink); font: inherit; cursor: pointer; }
  .collect-button { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; padding: .55rem 1rem; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--surface); box-shadow: 3px 3px 0 var(--ink); font-size: .85rem; font-weight: 650; transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease; }
  .collect-button > span:first-child { display: grid; place-items: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; background: #ffe1e5; color: var(--primary); font-size: 1.2rem; line-height: 1; transition: transform 180ms ease; }
  .collect-button:hover { background: #fffaf1; border-color: var(--ink); box-shadow: 1px 1px 0 var(--ink); transform: translate(2px, 2px) rotate(-1deg); }
  .collect-button:hover > span:first-child { transform: rotate(90deg) scale(1.08); }
  .collect-button:active { box-shadow: none; transform: translate(3px, 3px); }
  .collect-button[data-collected="true"] { border-color: var(--ink); box-shadow: 2px 2px 0 #1c1b1a55; }
  .discover-link { display: inline-block; padding: .5rem 0; font-size: .85rem; font-weight: 600; }
  .collection-button { position: relative; display: block; padding: .4rem .65rem .75rem 0; border: 0; background: none; width: 100%; }
  .collection-button :global(svg) { width: 12rem; margin: 0 auto -.15rem; transition: transform 220ms cubic-bezier(.2,.8,.3,1.3); }
  .collection-button:hover :global(svg) { transform: translateY(-4px) rotate(-1.5deg); }
  .collection-label { position: relative; display: flex; align-items: center; justify-content: center; gap: .5rem; min-height: 44px; border: 1.5px solid var(--ink); border-radius: 999px; background: var(--surface); box-shadow: 2px 3px 0 #1c1b1a20; font-size: .78rem; font-weight: 650; transition: transform 160ms ease; }
  .collection-button:hover .collection-label { color: var(--primary); transform: rotate(1deg); }
  .collection-count { display: grid; place-items: center; min-width: 1.5rem; height: 1.5rem; padding: 0 .25rem; border-radius: 50%; background: var(--primary); color: var(--paper); font-size: .72rem; }
  .play-spark { position: absolute; z-index: 2; top: .4rem; right: .25rem; color: #bd7716; font-size: 1.5rem; line-height: 1; pointer-events: none; animation: spark-twinkle 2.4s ease-in-out infinite; }
  .catch-burst { position: absolute; z-index: 3; left: 30%; top: 32%; width: 1px; height: 1px; pointer-events: none; }
  .catch-burst i { --pop-x: -35px; --pop-y: -34px; position: absolute; color: var(--primary); font: normal 700 1.35rem/1 var(--font-body); opacity: 0; }
  .catch-burst i:nth-child(2) { --pop-x: 15px; --pop-y: -48px; color: #bd7716; font-size: 1.05rem; }
  .catch-burst i:nth-child(3) { --pop-x: 42px; --pop-y: -16px; color: #4c7c59; font-size: 1rem; }
  .is-catching .catch-burst i { animation: catch-pop 1.9s ease-out both; }
  @keyframes spark-twinkle {
    0%, 100% { transform: rotate(-8deg) scale(.85); opacity: .6; }
    50% { transform: rotate(12deg) scale(1.15); opacity: 1; }
  }
  @keyframes catch-pop {
    0%, 63% { transform: translate(0, 8px) rotate(0deg) scale(.2); opacity: 0; }
    69% { opacity: 1; }
    80% { transform: translate(var(--pop-x), var(--pop-y)) rotate(24deg) scale(1.15); opacity: 1; }
    91%, 100% { transform: translate(var(--pop-x), var(--pop-y)) rotate(40deg) scale(.7); opacity: 0; }
  }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .flight-card { position: fixed; top: 0; left: 0; z-index: 20; display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 5px; width: 132px; height: 112px; padding: 7px; border: 2px solid var(--ink); border-radius: 10px; background: var(--surface); color: var(--ink); pointer-events: none; box-shadow: 4px 5px 0 #1c1b1a26; transform-origin: center; }
  .flight-heading { display: flex; align-items: baseline; gap: 5px; min-width: 0; line-height: 1; }
  .flight-card strong { flex-shrink: 0; color: var(--primary); font: 650 16px/1 var(--font-display); }
  .flight-heading > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 8px; font-weight: 650; }
