</svg>

<style>
  .election-dog { display: block; width: 100%; overflow: visible; pointer-events: none; }
  /* Every moving part pivots around a fixed point of the drawing, not its changing bounding box. */
  .election-dog :is(g, ellipse) { transform-box: view-box; }
  .dog-shadow { fill: var(--ink); opacity: .13; transform-origin: 100px 150px; }
  .dog-actor { transform-origin: 98px 150px; }
  .dog-breath { transform-origin: 110px 150px; }
  .dog-front-near { transform-origin: 96px 114px; }
  .dog-front-far { transform-origin: 107px 113px; }
  .dog-hind-near { transform-origin: 146px 114px; }
  .dog-hind-far { transform-origin: 138px 114px; }
  .dog-tail { transform-origin: 157px 110px; }
  .dog-tag { transform-origin: 86px 106px; }
  .dog-head-look, .dog-head { transform-origin: 80px 98px; }
  .dog-ear-near { transform-origin: 86px 44px; }
  .dog-ear-far { transform-origin: 52px 47px; }
  .dog-eyes-open, .dog-eyes-happy { transform-origin: 62px 61px; }
  .dog-nose { transform-origin: 30px 80px; }
  .dog-tongue { transform-origin: 44px 94px; }
  .dog-basket { transform-origin: 210px 150px; }

  .fur, .fur-far, .patch, .collar, .tag, .basket, .basket-rim, .card-paper {
    stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
  }
  .fur { fill: #fffaf1; }
  .fur-far { fill: #ece2d3; }
  .patch, .eye, .nose, .mouth { fill: var(--ink); }
  .patch:not(.ear) { stroke: none; }
  .outline { fill: none; }
  .muzzle { stroke-width: 2.2; }
  .fur-line, .mouth-line, .brow, .toe, .tag-ring, .tag-mark, .nose-glint, .ear-sheen, .card-ink, .basket-weave, .tongue-line {
    fill: none; stroke-linecap: round; stroke-linejoin: round;
  }
  .fur-line { stroke: #cfc5b6; stroke-width: 1.6; }
  .mouth-line { stroke: var(--ink); stroke-width: 2; }
  .brow { stroke: var(--ink); stroke-width: 1.8; }
  .toe { stroke: var(--ink); stroke-width: 1.4; }
  .freckles { fill: var(--ink); opacity: .55; }
  .blush { fill: #f4a49a; opacity: .55; }
  .glint { fill: #fff; }
  .nose-glint { stroke: #fff; stroke-opacity: .7; stroke-width: 1.4; }
  .ear-sheen { stroke: #fff; stroke-opacity: .16; stroke-width: 2; }
  .tongue { fill: #ee8a92; stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
  .tongue-line { stroke: #c25d6b; stroke-width: 1.1; }
  .collar { fill: var(--primary); stroke-width: 2; }
  .tag { fill: var(--paper); stroke-width: 1.6; }
  .tag-ring { stroke: var(--ink); stroke-width: 1.6; }
  .tag-mark { stroke: var(--primary); stroke-width: 1.4; }
  .basket { fill: #e7b45e; stroke-width: 2.2; }
  .basket-rim { fill: #f3cf85; stroke-width: 2.2; }
  .basket-weave { stroke: #a8732a; stroke-width: 1.5; }
  .card-paper { fill: var(--surface); stroke-width: 1.7; }
  .card-ink { stroke: var(--divider); stroke-width: 2; }
  .stack-card:not(.is-filled) { display: none; }
  .dog-mouth-open, .dog-eyes-happy { opacity: 0; }
  .dog-eyes-happy { fill: none; stroke: var(--ink); stroke-width: 2.4; stroke-linecap: round; }

  /* Gaze: a separate wrapper so the idle head animation never fights the look direction. */
  .dog-head-look { transform: rotate(var(--head-tilt, 0deg)); transition: transform 320ms cubic-bezier(.3,.7,.4,1); }
  .dog-eyes { transform: translate(var(--look-x, 0px), var(--look-y, 0px)); transition: transform 220ms ease-out; }

  /* Idle loop: deliberately unequal periods so the dog never looks like a metronome. */
  .dog-breath { animation: dog-breathe 3.6s ease-in-out infinite; }
  .dog-tail { animation: dog-tail-idle 5.3s ease-in-out infinite; }
  .dog-eyes-open { animation: dog-blink 5.9s linear infinite; }
  .dog-ear-near { animation: dog-ear-twitch 8.3s ease-in-out infinite; }
  .dog-head { animation: dog-sniff 11.2s ease-in-out infinite; }
  .dog-nose { animation: dog-nose-sniff 11.2s ease-in-out infinite; }
  .dog-tongue { animation: dog-pant 1.5s ease-in-out infinite; }
  .dog-tag { animation: dog-tag-sway 3.6s ease-in-out infinite; }

  /* Greeting on hover or keyboard focus: tilt the head, offer a paw, wag hard. */
  :global(.collection-button:is(:hover, :focus-visible)) .dog-head { animation: dog-greet-head 1100ms cubic-bezier(.3,.7,.3,1) both; }
  :global(.collection-button:is(:hover, :focus-visible)) .dog-front-near { animation: dog-give-paw 1100ms cubic-bezier(.3,.7,.3,1) both; }
  :global(.collection-button:is(:hover, :focus-visible)) .dog-ear-near { animation: dog-greet-ear 1100ms ease-out both; }
  :global(.collection-button:is(:hover, :focus-visible)) .dog-tail { animation: dog-eager-wag 180ms ease-in-out 6 alternate; }

  :global(.is-catching) :is(.dog-breath, .dog-tail, .dog-ear-near, .dog-head, .dog-nose, .dog-tag, .dog-front-near, .dog-eyes-open) { animation: none !important; }
  :global(.is-catching) .dog-tongue { opacity: 0; }
  :global(.is-resting) :is(.dog-breath, .dog-tail, .dog-eyes-open, .dog-ear-near, .dog-head, .dog-nose, .dog-tongue, .dog-tag) { animation-play-state: paused; }

  @keyframes dog-breathe {
    0%, 100% { transform: scale(1, 1); }
    50% { transform: scale(1.008, 1.016); }
  }
  @keyframes dog-tail-idle {
    0%, 100% { transform: rotate(-4deg); }
    12% { transform: rotate(6deg); }
    24% { transform: rotate(-3deg); }
    58% { transform: rotate(-5deg); }
    64%, 76% { transform: rotate(16deg); }
    70%, 82% { transform: rotate(-12deg); }
    88% { transform: rotate(4deg); }
  }
  @keyframes dog-blink {
    0%, 46%, 49.5%, 100% { transform: scaleY(1); }
    47.6% { transform: scaleY(.1); }
  }
  @keyframes dog-ear-twitch {
    0%, 80%, 100% { transform: rotate(0deg); }
    83% { transform: rotate(-9deg); }
    87% { transform: rotate(5deg); }
    91% { transform: rotate(-2deg); }
  }
  @keyframes dog-sniff {
    0%, 30%, 52%, 100% { transform: rotate(0deg); }
    36%, 46% { transform: rotate(7deg); }
    41% { transform: rotate(6deg) translateY(-1px); }
    74% { transform: rotate(-3deg); }
    84% { transform: rotate(0deg); }
  }
  @keyframes dog-nose-sniff {
    0%, 36%, 46%, 100% { transform: scale(1); }
    38%, 42% { transform: scale(1.08, .94); }
    40%, 44% { transform: scale(.96, 1.04); }
  }
  @keyframes dog-pant {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(1.14); }
  }
  @keyframes dog-tag-sway {
    0%, 100% { transform: rotate(5deg); }
    50% { transform: rotate(-5deg); }
  }
  @keyframes dog-greet-head {
    0%, 100% { transform: rotate(0deg); }
    22%, 72% { transform: rotate(10deg) translateY(-1px); }
    47% { transform: rotate(13deg) translateY(-1px); }
  }
  @keyframes dog-give-paw {
    0%, 100% { transform: rotate(0deg); }
    16% { transform: rotate(-5deg) translateY(1px); }
    34% { transform: rotate(80deg) translate(-2px, -4px); }
    46% { transform: rotate(64deg) translate(-2px, -4px); }
    58% { transform: rotate(80deg) translate(-2px, -4px); }
    70% { transform: rotate(66deg) translate(-2px, -3px); }
    88% { transform: rotate(-3deg); }
  }
  @keyframes dog-greet-ear {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(-14deg); }
    55% { transform: rotate(8deg); }
    78% { transform: rotate(-3deg); }
  }
  @keyframes dog-eager-wag { from { transform: rotate(-16deg); } to { transform: rotate(22deg); } }

  @media (prefers-reduced-motion: reduce) {
    .election-dog * { animation: none !important; transition: none !important; }
    .dog-head-look, .dog-eyes { transform: none; }
  }
</style>
