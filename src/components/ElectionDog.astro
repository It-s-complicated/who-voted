<style>
  .election-dog { display: block; width: 100%; overflow: visible; }
  .dog-shadow { fill: var(--ink); opacity: .11; transform-origin: center; }
  .dog-actor, .dog-body, .dog-head, .dog-leg, .dog-ear, .dog-tail { transform-box: fill-box; }
  .dog-actor { transform-origin: 55% 100%; }
  .dog-body { transform-origin: 50% 92%; }
  .dog-head { transform-origin: 68% 72%; transform: rotate(var(--head-tilt, -2deg)); }
  .dog-leg { transform-origin: 50% 10%; }
  .dog-ear { transform-origin: 50% 8%; }
  .dog-tail { transform-origin: 12% 82%; }
  .fur, .fur-far, .patch, .collar, .tag, .muzzle, .nose {
    stroke: var(--ink); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
  }
  .fur, .muzzle { fill: #fff9ee; }
  .fur-far { fill: #eee4d7; }
  .patch, .eye, .nose, .mouth-cavity { fill: var(--ink); }
  .back-patch, .forehead, .tail-tip { stroke: none; }
  .collar { fill: var(--primary); }
  .bandana { fill: #f4bd4f; stroke: var(--ink); stroke-width: 1.8; stroke-linejoin: round; }
  .bandana-fold { fill: none; stroke: #9c6720; stroke-width: 1.2; stroke-linecap: round; }
  .tag { fill: var(--paper); stroke-width: 1.8; }
  .muzzle { stroke-width: 2; }
  .muzzle-shade, .fur-detail, .detail, .collar-highlight, .tag-detail, .nose-glint {
    fill: none; stroke-linecap: round; stroke-linejoin: round;
  }
  .detail, .tag-detail { stroke: var(--ink); stroke-width: 1.5; }
  .brow { stroke-width: 1.7; }
  .toes { stroke-width: 1.25; }
  .fur-detail, .muzzle-shade { stroke: #b9b2a8; stroke-width: 1.35; }
  .collar-highlight { stroke: #fff; stroke-opacity: .45; stroke-width: 1.2; }
  .tag-detail { fill: var(--primary); stroke: none; }
  .nose-glint { stroke: #fff; stroke-opacity: .65; stroke-width: 1.3; }
  .blush { fill: #f2a99f; opacity: .72; }
  .blush-tick { fill: none; stroke: #cc776f; stroke-width: 1; stroke-linecap: round; }
  .ear-detail { fill: none; stroke: #fff; stroke-opacity: .22; stroke-width: 1.5; stroke-linecap: round; }
  .ear-detail-soft { stroke-opacity: .12; }
  .eye-white { fill: #fffdf8; stroke: var(--ink); stroke-width: 1.4; }
  .eye-patch { fill: #c9beb0; }
  .whiskers { stroke-width: 2.4; }
  .bandana-dot { stroke: #fff9ee; stroke-width: 2; stroke-linecap: round; }
  .dog-blink, .dog-pant, .dog-scarf, .dog-tag { transform-box: fill-box; }
  .dog-blink { transform-origin: center; animation: double-blink 6.7s linear infinite; }
  .dog-pant { transform-origin: top; animation: happy-pant 1.4s ease-in-out infinite; }
  .dog-scarf, .dog-tag { transform-origin: 25% 0%; }
  .dog-scarf { animation: scarf-drift 2.8s ease-in-out infinite; }
  .dog-tag { animation: tag-swing 2.8s ease-in-out infinite; }
  .glint { fill: var(--paper); }
  .dog-eyes { transform: translate(var(--look-x, 0px), var(--look-y, 0px)); }
  .dog-head, .dog-eyes { transition: transform 220ms ease-out; }
  .dog-mouth-open { opacity: 0; }
  .tongue { fill: #ef8791; stroke: var(--ink); stroke-width: 1.25; stroke-linejoin: round; }
  .tongue-detail { fill: none; stroke: #bd5968; stroke-width: 1; stroke-linecap: round; }
  :global(.is-catching) .dog-tongue-rest { opacity: 0; }
  .dog-body { animation: dog-breathe 3.4s ease-in-out infinite; }
  .dog-tail { animation: tail-wag 2.8s ease-in-out infinite; }
  .dog-ear-near { animation: ear-dream 6.7s ease-in-out infinite; }
  .dog-head { animation: head-hello 6.7s ease-in-out infinite; }
  /* A greeting is a short performance, not a permanently bouncing button. */
  :global(.collection-button:is(:hover, :focus-visible)) .dog-body { animation: play-bow 900ms cubic-bezier(.22,.7,.3,1) both; }
  :global(.collection-button:is(:hover, :focus-visible)) .dog-tail { animation: eager-wag 240ms ease-in-out 4 alternate; }
  :global(.collection-button:is(:hover, :focus-visible)) .dog-ear { animation: greeting-flop 900ms ease-out; }
  :global(.is-catching) .dog-body,
  :global(.is-catching) .dog-head,
  :global(.is-catching) .dog-ear,
  :global(.is-catching) .dog-tail,
  :global(.is-catching) .dog-scarf,
  :global(.is-catching) .dog-tag { animation: none !important; }
  :global(.is-catching) .dog-blink { animation: none; }
  :global(.is-resting) :is(.dog-body, .dog-head, .dog-tail, .dog-ear, .dog-blink, .dog-pant, .dog-scarf, .dog-tag) { animation-play-state: paused; }
  @keyframes dog-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.006, 1.018); }
  }
  @keyframes tail-wag {
    0%, 48%, 100% { transform: rotate(-7deg); }
    8%, 24%, 40% { transform: rotate(18deg); }
    16%, 32% { transform: rotate(-15deg); }
    65%, 82% { transform: rotate(-3deg); }
  }
  @keyframes eager-wag { from { transform: rotate(-20deg); } to { transform: rotate(26deg); } }
  @keyframes ear-dream {
    0%, 72%, 100% { transform: rotate(0deg); }
    79% { transform: rotate(11deg); }
    84% { transform: rotate(-7deg); }
    89% { transform: rotate(3deg); }
  }
  @keyframes head-hello {
    0%, 66%, 100% { transform: rotate(var(--head-tilt, -2deg)); }
    75%, 82% { transform: rotate(-10deg) translateY(-2px); }
    90% { transform: rotate(3deg); }
  }
  @keyframes double-blink {
    0%, 40%, 44%, 48%, 100% { transform: scaleY(1); }
    42%, 46% { transform: scaleY(.08); }
  }
  @keyframes happy-pant {
    0%, 65%, 100% { transform: scaleY(1) rotate(-4deg); }
    30% { transform: scaleY(1.2) rotate(3deg); }
  }
  @keyframes scarf-drift { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(6deg); } }
  @keyframes tag-swing { 0%, 100% { transform: rotate(8deg); } 50% { transform: rotate(-9deg); } }
  @keyframes play-bow {
    0%, 100% { transform: none; }
    30%, 48% { transform: translateY(4px) rotate(-7deg) scale(1.04, .91); }
    68% { transform: translateY(-5px) rotate(2deg) scale(.98, 1.04); }
    84% { transform: translateY(1px) scale(1.02, .98); }
  }
  @keyframes greeting-flop {
    0%, 100% { transform: rotate(0); }
    35% { transform: rotate(-14deg); }
    65% { transform: rotate(20deg); }
    82% { transform: rotate(-8deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dog-head, .dog-eyes { transition: none; }
    .election-dog * { animation: none !important; }
  }
</style>
