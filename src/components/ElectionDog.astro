---
import { dogMarkup, VIEWBOX } from "../lib/companion-dog";

const { x, y, width, height } = VIEWBOX;
---

<svg class="election-dog" viewBox={`${x} ${y} ${width} ${height}`} aria-hidden="true" focusable="false" set:html={dogMarkup()} />

<style is:global>
  /* The SVG's contents come from set:html, so these rules are global and scoped by class. */
  .election-dog {
    --fur: #fffdf7; --fur-far: #e8dfd2; --line: var(--ink);
    display: block; width: 100%; height: auto; overflow: visible;
  }
  .election-dog g, .election-dog use, .election-dog path, .election-dog ellipse { transform-box: view-box; }
  .election-dog .pass.outline { fill: var(--line); stroke: var(--line); stroke-width: 4.4; stroke-linejoin: round; }
  .election-dog .pass.fill { fill: var(--fur); stroke: none; }
  .election-dog .pass.fill.far { fill: var(--fur-far); }
  .election-dog .mouth-inside { display: none; }
  .election-dog.is-mouth-open .pass.fill .mouth-inside { display: inline; fill: #4a2b2e; }
  .election-dog .mouth-inside [data-bone="jaw"] { fill: #ec8c92; }
  .election-dog.is-mouth-open .smile { display: none; }
  .election-dog .ear { fill: var(--line); stroke: var(--line); stroke-width: 2.2; stroke-linejoin: round; }
  .election-dog .patch, .election-dog .eye, .election-dog .nose { fill: var(--line); }
  .election-dog .fur-line { fill: none; stroke: #c9bfb1; stroke-width: 1.3; stroke-linecap: round; }
  .election-dog .collar { fill: var(--primary); stroke: var(--line); stroke-width: 1.6; stroke-linejoin: round; }
  .election-dog .collar-highlight { fill: none; stroke: #fff; stroke-opacity: .45; stroke-width: 1.1; stroke-linecap: round; }
  .election-dog .tag { fill: #e3a73c; stroke: var(--line); stroke-width: 1.5; }
  .election-dog .tag-ring { stroke: var(--line); stroke-width: 1.5; }
  .election-dog .glint { fill: #fff; }
  .election-dog .brow, .election-dog .smile { fill: none; stroke: var(--line); stroke-width: 1.7; stroke-linecap: round; }
  .election-dog .eyes-happy { display: none; fill: none; stroke: var(--line); stroke-width: 2.4; stroke-linecap: round; }
  .election-dog.is-happy .eyes-open { display: none; }
  .election-dog.is-happy .eyes-happy { display: inline; }
  .election-dog .blush { fill: #f19a92; opacity: .5; }
  .election-dog .nose-glint { fill: none; stroke: #fff; stroke-opacity: .7; stroke-width: 1.2; stroke-linecap: round; }
  .election-dog .dog-shadow { fill: var(--ink); opacity: .12; }
  .election-dog .bite { fill: none; }

  /* Idle life. Pivots are in drawing units (see PIVOT in companion-dog.ts). */
  .election-dog .idle-root { transform-origin: 126px 140px; animation: dog-breathe 3.6s ease-in-out infinite; }
  .election-dog .idle-head { transform-origin: 92px 72px; rotate: var(--head-tilt, 0deg); transition: rotate 260ms ease-out; animation: dog-glance 9.4s ease-in-out infinite; }
  .election-dog .dog-eyes { transform-origin: 56px 47px; translate: var(--look-x, 0px) var(--look-y, 0px); transition: translate 200ms ease-out; animation: dog-blink 5.8s linear infinite; }
  .election-dog .idle-tail { transform-origin: 162px 82px; animation: dog-wag 4.2s ease-in-out infinite; }
  .election-dog .idle-ear { transform-origin: 83px 38px; animation: dog-ear 7.3s ease-in-out infinite; }
  .election-dog .idle-frontNear { transform-origin: 101px 96px; transition: transform 240ms cubic-bezier(.3,.7,.3,1.3); }
  .election-dog .idle-frontNearKnee { transform-origin: 100px 119px; transition: transform 240ms ease-out; }

  /* Greeting: hovering or focusing the collection offers a paw. */
  .collection-button:is(:hover, :focus-visible) .election-dog .idle-frontNear { transform: rotate(72deg); }
  .collection-button:is(:hover, :focus-visible) .election-dog .idle-frontNearKnee { transform: rotate(-38deg); }
  .collection-button:is(:hover, :focus-visible) .election-dog .idle-head { animation: dog-greet 1.2s ease-in-out infinite; }
  .collection-button:is(:hover, :focus-visible) .election-dog .idle-tail,
  election-companion:has([data-add][data-collected="false"]:is(:hover, :focus-visible)) .election-dog .idle-tail { animation: dog-eager 300ms ease-in-out infinite alternate; }
  /* Pointing at the collect button: ready for the throw. */
  election-companion:has([data-add][data-collected="false"]:is(:hover, :focus-visible)) .election-dog .idle-root { animation: dog-ready 700ms ease-out both; }

  .is-catching .election-dog :is(.idle-root, .idle-head, .idle-tail, .idle-ear, .idle-frontNear, .idle-frontNearKnee) { animation: none; transform: none; rotate: none; transition: none; }
  .is-catching .election-dog .dog-eyes { translate: none; }
  .is-resting .election-dog * { animation-play-state: paused !important; }

  @keyframes dog-breathe { 50% { transform: scale(1.008, 1.016); } }
  @keyframes dog-blink { 0%, 46%, 49%, 92%, 95%, 98%, 100% { transform: none; } 47.5%, 93.5%, 96.5% { transform: scaleY(.12); } }
  @keyframes dog-glance { 0%, 62%, 82%, 100% { transform: none; } 67%, 77% { transform: rotate(9deg); } }
  @keyframes dog-greet { 0%, 100% { transform: rotate(6deg); } 50% { transform: rotate(11deg); } }
  @keyframes dog-wag {
    0%, 30%, 100% { transform: rotate(0deg); }
    4%, 12%, 20% { transform: rotate(16deg); }
    8%, 16%, 24% { transform: rotate(-10deg); }
    60% { transform: rotate(5deg); }
  }
  @keyframes dog-eager { from { transform: rotate(-14deg); } to { transform: rotate(20deg); } }
  @keyframes dog-ear { 0%, 80%, 100% { transform: none; } 84% { transform: rotate(-9deg); } 88% { transform: rotate(4deg); } 92% { transform: rotate(-2deg); } }
  @keyframes dog-ready { to { transform: scale(1.04, .94); } }

  @media (prefers-reduced-motion: reduce) {
    .election-dog *, .election-dog { animation: none !important; transition: none !important; }
    .collection-button:is(:hover, :focus-visible) .election-dog :is(.idle-frontNear, .idle-frontNearKnee) { transform: none; }
  }
</style>
